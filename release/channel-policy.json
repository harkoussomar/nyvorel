{
  "schema": 2,
  "product": "Nyvorel",
  "policy_status": "release-tooling-implemented",
  "channels": {
    "stable": {
      "user_default": true,
      "remote_ref_kind": "immutable-semver-tag",
      "tag_pattern": "v{version}",
      "github_release_required": true,
      "prerelease_allowed": false,
      "same_version_different_commit": "refuse",
      "downgrade": "refuse",
      "mutable": false
    },
    "development": {
      "user_default": false,
      "opt_in_required": true,
      "remote": "origin",
      "branch": "main",
      "remote_ref_kind": "branch",
      "same_version_different_commit": "allow",
      "downgrade": "refuse",
      "mutable": true
    },
    "explicit-source": {
      "user_default": false,
      "opt_in_required": true,
      "remote_ref_kind": "local-source-tree",
      "same_version_different_commit": "allow",
      "downgrade": "explicit-override-only",
      "dirty_source": "explicit-override-only",
      "mutable": true
    }
  },
  "update_cli_target": {
    "fetch_default_channel": "stable",
    "development_channel": "explicit-opt-in",
    "explicit_source_is_not_a_remote_channel": true,
    "implementation_phase": "6B-complete",
    "stable_release_discovery": "GitHub Releases API: highest non-draft, non-prerelease strict semver tag",
    "stable_checkout": "isolated temporary clone",
    "development_fetch": "origin/main fast-forward"
  },
  "same_version_policy": {
    "stable": "A stable version identifies one immutable release commit; a different commit with the same VERSION is invalid for stable updates.",
    "development": "main may advance through multiple commits before VERSION is bumped; same-version commit updates are permitted only on the explicitly selected development channel.",
    "explicit-source": "An explicitly supplied local source may carry the same VERSION at another commit; the user selected that source directly."
  },
  "release_invariants": {
    "version_format": "MAJOR.MINOR.PATCH",
    "tag_format": "v{version}",
    "tag_must_match_version": true,
    "tag_must_be_immutable": true,
    "stable_release_must_not_be_draft": true,
    "stable_release_must_not_be_prerelease": true,
    "changelog_release_heading_required": true,
    "changelog_release_heading_format": "## [{version}] - YYYY-MM-DD",
    "release_commit_must_be_clean": true,
    "release_ci_must_be_green": true,
    "unreleased_section_retained_after_release": true
  },
  "maintenance": {
    "current_line": "0.1.x",
    "versioning": "semver-patch",
    "release_source": "reviewed-clean-main-commit",
    "existing_release_tags_may_move": false,
    "existing_github_releases_may_be_retargeted": false,
    "separate_maintenance_branch_required_now": false,
    "future_backport_branch_pattern": "release/{major}.{minor}",
    "next_patch_policy": "increment-highest-stable-patch"
  },
  "implementation_status": {
    "stable_channel_resolution": "implemented-6B",
    "development_channel_opt_in": "implemented-6B",
    "release_preflight_automation": "candidate-preflight-implemented-6C1",
    "installer_general_version_support": "implemented-6C1",
    "upgrade_path_matrix": "pending-6D",
    "release_publication_tooling": "implemented-6C2"
  },
  "legacy_behavior": {
    "origin_main_default_fetch_retired_in": "6B",
    "stable_fetch_default": "--fetch",
    "development_replacement": "--fetch --channel development",
    "history_rewrite_required": false
  },
  "release_tooling": {
    "candidate_preflight": "scripts/release/preflight.sh",
    "preflight_mutates_repository": false,
    "preflight_publishes_release": false,
    "publication_tooling": "scripts/release/publish.sh",
    "publication_requires_explicit_action": true,
    "publication_confirmation": "--publish --yes",
    "plan_mode_mutates_repository": false,
    "main_ci_required": true,
    "tag_ci_required": true,
    "release_created_after_tag_ci": true,
    "existing_tag_may_move": false,
    "partial_publication_is_resumable": true,
    "release_notes_source": "CHANGELOG release section"
