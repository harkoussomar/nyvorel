# nyvorel-super-scroll policy
#
# Normal mouse/touchpad scrolling is configured ONLY in:
#   ~/.config/hypr/hyprland/general.conf
#
# These are absolute TEMPORARY targets used only while Super is held past the
# threshold. They preserve the pre-refactor behavior (mouse 5, touchpad 10).
NYVOREL_SUPER_HOLD_MS=250
NYVOREL_FAST_MOUSE_SCROLL=5
NYVOREL_FAST_TOUCHPAD_SCROLL=12
