#!/usr/bin/env bash
set -Eeuo pipefail

BIN_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

usage() {
  cat <<'EOF'
Nyvorel command line

Usage:
  nyvorel doctor [options]
  nyvorel bootstrap [options]
  nyvorel update [options]
  nyvorel settings
  nyvorel help

Commands:
  doctor    Run read-only Nyvorel installation/session diagnostics.
  bootstrap Build a read-only Arch dependency package plan.
  update    Safely update the manifest-backed Nyvorel installation.
  settings  Open Nyvorel Settings.
  help      Show this help.

Examples:
  nyvorel doctor
  nyvorel doctor --deep
  nyvorel doctor --json
  nyvorel bootstrap
  nyvorel bootstrap --list-optional
  nyvorel bootstrap --optional screenshots
  nyvorel update --dry-run
  nyvorel update --fetch --yes
EOF
}

case "${1:-help}" in
  doctor)
    shift
    exec "$BIN_DIR/nyvorel-doctor" "$@"
    ;;
  bootstrap)
    shift
    exec "$BIN_DIR/nyvorel-bootstrap" "$@"
    ;;
  update)
    shift
    exec "$BIN_DIR/nyvorel-update" "$@"
    ;;
  settings)
    shift
    exec "$BIN_DIR/nyvorel-settings" "$@"
    ;;
  help|-h|--help)
    usage
    ;;
  *)
    printf 'ERROR: unknown Nyvorel command: %s\n\n' "$1" >&2
    usage >&2
    exit 2
    ;;
esac
