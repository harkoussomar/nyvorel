#!/usr/bin/env python3
from __future__ import annotations

import os
import re
import subprocess
import sys
from pathlib import Path

HOME = Path.home()
XDG_CONFIG = Path(os.environ.get("XDG_CONFIG_HOME", HOME / ".config"))
RULES = XDG_CONFIG / "hypr/custom/appearance-runtime.lua"
TERMINAL_SYNC = HOME / ".local/bin/nyvorel-terminal-theme-sync"

BEGIN = "-- >>> nyvorel-fluid-interface-v1 >>>"
END = "-- <<< nyvorel-fluid-interface-v1 <<<"

BLOCK = '-- >>> nyvorel-fluid-interface-v1 >>>\n-- Fluid: Caelestia-style transparent/xray layer material.\nhl.layer_rule({["blur"] = true, ["match"] = {["namespace"] = "^quickshell:(bar|verticalBar|sidebarLeft|sidebarRight|appearanceStudio|popup|notificationPopup|mediaControls|onScreenDisplay|session)$"}, ["name"] = "appearance-block-1"})\nhl.layer_rule({["blur_popups"] = true, ["match"] = {["namespace"] = "^quickshell:(bar|verticalBar|sidebarLeft|sidebarRight|appearanceStudio|popup|notificationPopup|mediaControls|onScreenDisplay|session)$"}, ["name"] = "appearance-block-2"})\nhl.layer_rule({["xray"] = true, ["match"] = {["namespace"] = "^quickshell:(bar|verticalBar|sidebarLeft|sidebarRight|appearanceStudio|popup|notificationPopup|mediaControls|onScreenDisplay|session)$"}, ["name"] = "appearance-block-3"})\nhl.layer_rule({["ignore_alpha"] = 0.57, ["match"] = {["namespace"] = "^quickshell:(bar|verticalBar|sidebarLeft|sidebarRight|appearanceStudio|popup|notificationPopup|mediaControls|onScreenDisplay|session)$"}, ["name"] = "appearance-block-4"})\n\n-- Reference-terminal geometry.\nhl.window_rule({["border_size"] = 2, ["match"] = {["class"] = "^(kitty)$"}, ["name"] = "appearance-block-5"})\nhl.window_rule({["rounding"] = 8, ["match"] = {["class"] = "^(kitty)$"}, ["name"] = "appearance-block-6"})\n-- <<< nyvorel-fluid-interface-v1 <<<\n'

def replace_block(text: str, replacement: str) -> str:
    pat = re.compile(re.escape(BEGIN) + r".*?" + re.escape(END) + r"\n?", re.S)
    text = pat.sub("", text).rstrip() + "\n"
    if replacement:
        text += "\n" + replacement.strip() + "\n"
    return text

def quiet(cmd: list[str]) -> None:
    try:
        subprocess.run(
            cmd,
            check=False,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=8,
        )
    except Exception:
        pass

def main() -> int:
    mode = sys.argv[1] if len(sys.argv) > 1 else "default"
    if mode not in {"fluid", "default"}:
        raise SystemExit(f"usage: {sys.argv[0]} [fluid|default]")

    RULES.parent.mkdir(parents=True, exist_ok=True)
    old = RULES.read_text(encoding="utf-8") if RULES.exists() else ""
    new = replace_block(old, BLOCK if mode == "fluid" else "")
    if new != old:
        RULES.write_text(new, encoding="utf-8")
        if TERMINAL_SYNC.is_file():
            quiet([str(TERMINAL_SYNC)])
        quiet(["hyprctl", "reload"])
    print(f"fluid-runtime-v1: mode={mode}")
    return 0

if __name__ == "__main__":
    raise SystemExit(main())
