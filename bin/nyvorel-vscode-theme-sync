THEME_FILE = THEME_DIR / "nyvorel-system.json"
PACKAGE_FILE = EXTENSION_DIR / "package.json"


# ============================================================
# Helpers
# ============================================================

def canonical(value: str) -> str:
    return re.sub(
        r"[^a-z0-9]",
        "",
        value.lower(),
    )


def normalize_hex(value, fallback: str) -> str:
    if not isinstance(value, str):
        return fallback

    value = value.strip()

    if re.fullmatch(r"[0-9a-fA-F]{6}", value):
        return "#" + value.upper()

    if re.fullmatch(r"#[0-9a-fA-F]{6}", value):
        return value.upper()

    if re.fullmatch(r"[0-9a-fA-F]{8}", value):
        return "#" + value.upper()

    if re.fullmatch(r"#[0-9a-fA-F]{8}", value):
        return value.upper()

    return fallback


def find_role(data, requested: str):
    requested_key = canonical(requested)

    # --------------------------------------------------------
    # Direct / recursive role lookup
    # --------------------------------------------------------

    def search(obj):
        if not isinstance(obj, dict):
            return None

        # First check exact role keys at this level.
        for key, value in obj.items():
            if canonical(key) == requested_key:
                if isinstance(value, str):
                    return value

                if isinstance(value, dict):
                    # Accommodate slightly different generated formats.
                    for child_key in (
                        "hex",
                        "value",
                        "default",
                        "color",
                    ):
                        child = value.get(child_key)

                        if isinstance(child, str):
                            return child

                        if isinstance(child, dict):
                            for nested_key in (
                                "hex",
                                "value",
                            ):
                                nested = child.get(nested_key)

                                if isinstance(nested, str):
                                    return nested

        # Then recurse.
        for value in obj.values():
            if isinstance(value, dict):
                found = search(value)

                if found is not None:
                    return found

        return None

    return search(data)


def alpha(hex_color: str, opacity: int) -> str:
    """
    VS Code accepts #RRGGBBAA.
    opacity is 0..255.
    """

    base = normalize_hex(
        hex_color,
        "#000000",
    )[:7]

    return f"{base}{opacity:02X}"


# ============================================================
# Load actual Nyvorel palette
# ============================================================

if not PALETTE_FILE.exists():
    raise SystemExit(
        "Nyvorel palette not found:\n"
        f"{PALETTE_FILE}\n\n"
        "Change/reapply your wallpaper once so II generates it."
    )


with PALETTE_FILE.open(
    "r",
    encoding="utf-8",
) as file:
    palette = json.load(file)


def c(role: str, fallback: str) -> str:
    return normalize_hex(
        find_role(
            palette,
            role,
        ),
        fallback,
    )


