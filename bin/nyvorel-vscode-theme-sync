# ============================================================
# Write local VS Code extension
# ============================================================

THEME_DIR.mkdir(
    parents=True,
    exist_ok=True,
)


package = {
    "name":
        "nyvorel-system-theme",

    "displayName":
        "Nyvorel System Theme",

    "description":
        "Generated from the active Nyvorel Material palette.",

    "version":
        "1.0.0",

    "publisher":
        "local",

    "engines": {
        "vscode":
            "^1.80.0"
    },

    "categories": [
        "Themes"
    ],

    "contributes": {
        "themes": [
            {
                "label":
                    "Nyvorel System",

                "uiTheme":
                    "vs-dark",

                "path":
                    "./themes/nyvorel-system.json",
            }
        ]
    },
}


theme = {
    "name":
        "Nyvorel System",

    "type":
        "dark",

    "semanticHighlighting":
        True,

    "colors":
        colors,

    "tokenColors":
        token_colors,
}


with PACKAGE_FILE.open(
    "w",
    encoding="utf-8",
) as file:
    json.dump(
        package,
        file,
        indent=4,
    )


with THEME_FILE.open(
    "w",
    encoding="utf-8",
) as file:
    json.dump(
        theme,
        file,
        indent=4,
    )


print()
print("Nyvorel → VS Code")
