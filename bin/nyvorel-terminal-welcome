#!/usr/bin/env python3
from __future__ import annotations

import json
import os
import platform
import re
import shlex
import shutil
import subprocess
import sys
import unicodedata
from pathlib import Path

HOME = Path.home()
PALETTE_FILE = HOME / ".local/state/quickshell/user/generated/colors.json"
NYVOREL_CONFIG = HOME / ".config/nyvorel/config.json"

RESET = "\x1b[0m"
BOLD = "\x1b[1m"


def _hex(v: str | None, role: str) -> str:
    if isinstance(v, str):
        s = v.strip().lstrip("#")
        if len(s) >= 6:
            s = s[:6]
            try:
                int(s, 16)
                return "#" + s.lower()
            except ValueError:
                pass
    raise RuntimeError(f"Missing or invalid system color role: {role}")


def interface_style() -> str:
    try:
        cfg = json.loads(NYVOREL_CONFIG.read_text(encoding="utf-8"))
        style = str(cfg.get("appearance", {}).get("interfaceStyle") or "").strip().lower()
        style = {"mica": "fluid", "glass": "fluid", "prism": "fluid", "inlay": "fluid", "solid": "default", "minimal": "default"}.get(style, style)
        if style in {"fluid", "default"}:
            return style
    except Exception:
        pass
    return "default"


STYLE = interface_style()


def load_palette() -> dict[str, str]:
    data = json.loads(PALETTE_FILE.read_text(encoding="utf-8"))
    return {
        "primary": _hex(data.get("primary"), "primary"),
        "text": _hex(data.get("on_surface") or data.get("on_background"), "on_surface"),
        "muted": _hex(data.get("on_surface_variant") or data.get("outline"), "on_surface_variant"),
        "outline": _hex(data.get("outline_variant") or data.get("outline"), "outline_variant"),
    }


def ansi_fg(h: str) -> str:
    h = h.lstrip("#")
    r, g, b = int(h[0:2], 16), int(h[2:4], 16), int(h[4:6], 16)
    return f"\x1b[38;2;{r};{g};{b}m"


def color(text: str, h: str, *, bold: bool = False) -> str:
    return (BOLD if bold else "") + ansi_fg(h) + text + RESET


def cell_width(text: str) -> int:
    width = 0
    for ch in text:
        cp = ord(ch)
        if unicodedata.combining(ch):
            continue
        # patched Nerd Font private-use glyphs render as single cell in terminal UIs
        if 0xE000 <= cp <= 0xF8FF or 0xF0000 <= cp <= 0xFFFFD or 0x100000 <= cp <= 0x10FFFD:
            width += 1
            continue
        width += 2 if unicodedata.east_asian_width(ch) in ("W", "F") else 1
    return width


def clip_cells(text: str, max_width: int) -> str:
    if cell_width(text) <= max_width:
        return text
    if max_width <= 1:
        return "…"
    out = []
    used = 0
    for ch in text:
        w = cell_width(ch)
        if used + w > max_width - 1:
            break
        out.append(ch)
        used += w
    return "".join(out) + "…"


def run(*args: str, timeout: float = 0.9) -> str:
    try:
        p = subprocess.run(
            args,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
            timeout=timeout,
            check=False,
        )
        return (p.stdout or "").strip()
    except Exception:
        return ""


def uptime_text() -> str:
    try:
        seconds = int(float(Path("/proc/uptime").read_text().split()[0]))
        days, rem = divmod(seconds, 86400)
        hours, rem = divmod(rem, 3600)
        minutes = rem // 60
        if days:
            return f"{days}d {hours}h {minutes}m"
        if hours:
            return f"{hours}h {minutes}m"
        return f"{minutes}m"
    except Exception:
        return "—"


def cpu_details() -> tuple[str, str]:
    try:
        cpuinfo = Path("/proc/cpuinfo").read_text()
        model = re.search(r"(?m)^model name\s*:[ \t]*(.+)$", cpuinfo)
        threads = len(re.findall(r"(?m)^processor\s*:", cpuinfo))
        name = re.sub(r"\([RT]M?\)", "", model[1]).strip() if model else ""
        return name or platform.machine() or "—", str(threads) if threads else "—"
    except OSError:
        return platform.machine() or "—", "—"


def load_text() -> str:
    try:
        return " / ".join(f"{load:.2f}" for load in os.getloadavg())
    except OSError:
        return "—"


def memory_text() -> str:
    try:
        vals = {}
        for line in Path("/proc/meminfo").read_text().splitlines():
            if ":" in line:
                k, rest = line.split(":", 1)
                vals[k] = int(rest.strip().split()[0])
        total = vals["MemTotal"]
        available = vals.get("MemAvailable", vals.get("MemFree", 0))
        used = max(0, total - available)
        return f"{used / 1048576:.1f} / {total / 1048576:.1f} GiB · {used / total:.0%}"
    except Exception:
        return "—"


def disk_text() -> str:
    try:
        usage = shutil.disk_usage(HOME)
        return f"{usage.used / 2**30:.0f} / {usage.total / 2**30:.0f} GiB · {usage.used / usage.total:.0%}"
    except Exception:
        return "—"


def package_count() -> str:
    try:
        root = Path("/var/lib/pacman/local")
        return str(sum(1 for p in root.iterdir() if p.is_dir() and not p.name.startswith(".")))
    except Exception:
        return "—"


def resolution() -> str:
    raw = run("hyprctl", "monitors", "-j", timeout=0.7)
    if not raw:
        return "—"
    try:
        monitors = json.loads(raw)
        mon = next((m for m in monitors if m.get("focused")), monitors[0] if monitors else None)
        if mon:
            size = f"{mon['width']}×{mon['height']}"
            refresh = mon.get("refreshRate")
            return f"{size} · {refresh:.0f} Hz" if refresh else size
    except Exception:
        pass
    return "—"


def os_text() -> str:
    try:
        return platform.freedesktop_os_release().get("PRETTY_NAME") or platform.system()
    except OSError:
        return platform.system()


def graphics_names() -> list[str]:
    names = []
    for line in run("lspci", "-mm", "-nn", timeout=0.3).splitlines():
        try:
            _, device_class, vendor, device, *_ = shlex.split(line)
        except ValueError:
            continue
        if re.search(r"\[03[0-9a-f]{2}\]$", device_class):
            name = re.sub(r" \[[0-9a-f]{4}\]$", "", device)
            model = re.search(r"\[([^\]]+)\]$", name)
            if name == "Device":
                names.append(f"{vendor.split(' [', 1)[0]} {device}")
            else:
                names.append(model[1] if model else name)
    return names


def battery_details() -> list[str]:
    batteries = []
    for supply in sorted(Path("/sys/class/power_supply").glob("*")):
        try:
            if (supply / "type").read_text().strip() != "Battery":
                continue
            capacity = int((supply / "capacity").read_text())
            status = (supply / "status").read_text().strip()
        except (OSError, ValueError):
            continue
        if 0 <= capacity <= 100:
            batteries.append(f"{capacity}% · {status}" if status and status != "Unknown" else f"{capacity}%")
    return batteries


ARCH_RAW = [
    "                   -`",
    "                  .o+`",
    "                 `ooo/",
    "                `+oooo:",
    "               `+oooooo:",
    "               -+oooooo+:",
    "             `/:-:++oooo+:",
    "            `/++++/+++++++:",
    "           `/++++++++++++++:",
    "          `/+++ooooooooooooo/`",
    "         ./ooosssso++osssssso+`",
    "        .oossssso-````/ossssss+`",
    "       -osssssso.      :ssssssso.",
    "      :osssssss/        osssso+++.",
    "     /ossssssss/        +ssssooo/-",
    "   `/ossssso+/:-        -:/+osssso+-",
    "  `+sso+:-`                 `.-/+oso:",
    " `++:.                           `-/+/",
    " .`                                 `/",
]


def frame_chars() -> dict[str, str]:
    if STYLE == "default":
        return {"tl": "+", "tr": "+", "ml": "+", "mr": "+", "bl": "+", "br": "+", "v": "|", "h": "-"}
    return {"tl": "╭", "tr": "╮", "ml": "├", "mr": "┤", "bl": "╰", "br": "╯", "v": "│", "h": "─"}


def panel_top(title: str, icon: str, width: int, p: dict[str, str]) -> str:
    f = frame_chars()
    inner = width - 2
    label = f" {icon} {title} "
    fill = max(0, inner - cell_width(label))
    return (
        color(f["tl"], p["outline"])
        + color(label, p["primary"], bold=True)
        + color(f["h"] * fill, p["outline"])
        + color(f["tr"], p["outline"])
    )


def panel_mid_rule(width: int, p: dict[str, str]) -> str:
    f = frame_chars()
    return (
        color(f["ml"], p["outline"])
        + color(f["h"] * (width - 2), p["outline"])
        + color(f["mr"], p["outline"])
    )


def panel_bottom(width: int, p: dict[str, str]) -> str:
    f = frame_chars()
    return color(f["bl"] + (f["h"] * (width - 2)) + f["br"], p["outline"])


def panel_row(icon: str, label: str, value: str, width: int, p: dict[str, str]) -> str:
    f = frame_chars()
    inner = width - 2
    left = f" {icon} {label}"
    left_w = cell_width(left)
    max_value_w = max(1, inner - left_w - 2)
    value = clip_cells(value, max_value_w)
    gap = inner - left_w - cell_width(value) - 1
    return (
        color(f["v"], p["outline"])
        + color(left, p["muted"])
        + (" " * gap)
        + color(value, p["text"])
        + " "
        + color(f["v"], p["outline"])
    )


def system_rows() -> tuple[list[tuple[str, str, str]], list[tuple[str, str, str]]]:
    desktop = os.environ.get("XDG_CURRENT_DESKTOP", "").replace(":", " / ")
    session_type = os.environ.get("XDG_SESSION_TYPE", "")
    session = " · ".join(filter(None, (desktop, session_type.capitalize())))
    identity = [
        ("󰌽", "OS", os_text()),
        ("󰌢", "Host", platform.node() or "—"),
        ("󰒋", "Kernel", platform.release()),
        ("󰥔", "Uptime", uptime_text()),
        ("󰏖", "Packages", package_count()),
    ]
    if session:
        identity.append(("󰆍", "Session", session))

    cpu, threads = cpu_details()
    hardware = [
        ("", "CPU", cpu),
        ("󰔡", "Threads", threads),
        ("󰓅", "Load 1/5/15m", load_text()),
    ]
    for index, name in enumerate(graphics_names(), start=1):
        hardware.append(("󰢮", "GPU" if index == 1 else f"GPU {index}", name))
    hardware.extend([
        ("󰍛", "Memory", memory_text()),
        ("󰋊", "Home disk", disk_text()),
        ("󰍹", "Display", resolution()),
    ])
    for index, status in enumerate(battery_details(), start=1):
        hardware.append(("󰁹", "Battery" if index == 1 else f"Battery {index}", status))
    return identity, hardware


def render() -> str:
    p = load_palette()
    cols = max(1, shutil.get_terminal_size((105, 30)).columns - 1)
    identity, hardware = system_rows()
    if cols < 28:
        return "\n" + "".join(
            color(clip_cells(f"{label}  {value}", cols), p["text"]) + "\n"
            for _, label, value in identity + hardware
        )

    art = ARCH_RAW
    art_width = max(map(len, art))
    gap = "  "
    side_by_side = cols >= art_width + len(gap) + 37
    panel_width = min(66, cols - (art_width + len(gap) if side_by_side else 0))
    panel = [panel_top("System", "󰆍", panel_width, p)]
    panel.extend(panel_row(*row, panel_width, p) for row in identity)
    panel.append(panel_mid_rule(panel_width, p))
    panel.extend(panel_row(*row, panel_width, p) for row in hardware)
    panel.append(panel_bottom(panel_width, p))

    if not side_by_side:
        if cols < art_width:
            return "\n".join(["", *panel, ""])
        left_pad = " " * ((panel_width - art_width) // 2)
        logo = [left_pad + color(line, p["primary"], bold=True) for line in art]
        return "\n".join(["", *logo, "", *panel, ""])

    height = max(len(art), len(panel))
    art_top = (height - len(art)) // 2
    panel_top_offset = (height - len(panel)) // 2
    lines = [""]
    for index in range(height):
        left = art[index - art_top] if art_top <= index < art_top + len(art) else ""
        right = panel[index - panel_top_offset] if panel_top_offset <= index < panel_top_offset + len(panel) else ""
        lines.append(color(left.ljust(art_width), p["primary"], bold=True) + gap + right)
    return "\n".join([*lines, ""])


def main() -> int:
    text = render()
    if "--check" not in sys.argv:
        sys.stdout.write(text)
        sys.stdout.flush()
    return 0


if __name__ == "__main__":
    raise SystemExit(main())

