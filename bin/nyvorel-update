#!/usr/bin/env python3
from __future__ import annotations

import argparse
from dataclasses import dataclass
from datetime import datetime
import hashlib
import json
import os
from pathlib import Path
import re
import shutil
import stat
import subprocess
import sys
import tempfile
import time
from typing import Any
from urllib.parse import urlparse
from urllib.request import Request, urlopen

HOME_TOKEN = "@" + "HOME" + "@"
HOME_TOKEN_BYTES = HOME_TOKEN.encode()
STABLE_TAG_RE = re.compile(r"^v(\d+)\.(\d+)\.(\d+)$")
RUNTIME_REL = ".config/hypr/custom/appearance-runtime.conf"
RUNTIME_RELS = {
    RUNTIME_REL,
    ".config/hypr/hyprland/colors.conf",
    ".config/hypr/hyprlock/colors.conf",
}
LEGACY_APPEARANCE_MARKERS = {
    ".config/hypr/custom/general.conf": ("Appearance Studio: window radius",),
    ".config/hypr/custom/rules.conf": (
        "appearance-studio-glass-runtime-v2",
        "nyvorel-fluid-interface-v1",
    ),
}


@dataclass(frozen=True)
class Item:
    src: Path
    rel: Path


class UpdateError(RuntimeError):
    pass


def lexists(path: Path) -> bool:
    return os.path.lexists(path)


def sha256_file(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def installed_digest(path: Path) -> dict[str, str]:
    if path.is_symlink():
        return {"kind": "symlink", "value": os.readlink(path)}
    return {"kind": "file", "value": sha256_file(path)}


def copy_path(src: Path, dest: Path) -> None:
    dest.parent.mkdir(parents=True, exist_ok=True)
    if lexists(dest):
        if dest.is_dir() and not dest.is_symlink():
            shutil.rmtree(dest)
        else:
            dest.unlink()

    if src.is_symlink():
        os.symlink(os.readlink(src), dest)
    else:
        shutil.copy2(src, dest, follow_symlinks=False)


def remove_path(path: Path) -> None:
    if not lexists(path):
        return
    if path.is_dir() and not path.is_symlink():
        shutil.rmtree(path)
    else:
        path.unlink()


def git_output(root: Path, *args: str) -> str:
    proc = subprocess.run(
        ["git", "-C", str(root), *args],
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        check=False,
    )
    if proc.returncode != 0:
        return ""
    return proc.stdout.strip()


def parse_version(raw: str) -> tuple[int, int, int]:
    parts = raw.strip().split(".")
    if len(parts) != 3 or any(not part.isdigit() for part in parts):
        raise UpdateError(f"invalid semantic VERSION: {raw!r}")
    return tuple(int(part) for part in parts)  # type: ignore[return-value]


def add_tree(items: list[Item], src_root: Path, dest_root: Path) -> None:
    if not src_root.is_dir():
        raise UpdateError(f"required source directory missing: {src_root}")

    for src in sorted(src_root.rglob("*")):
        if src.is_dir():
            continue
        if not (src.is_file() or src.is_symlink()):
            continue
        if "__pycache__" in src.parts or src.suffix in {".pyc", ".pyo"}:
            continue
        if ".before-" in src.name or ".pre-" in src.name:
            continue
        rel_inside = src.relative_to(src_root)
        items.append(Item(src=src, rel=dest_root / rel_inside))


def build_items(root: Path, source_kind: str = "source-clone") -> list[Item]:
    if source_kind not in {"source-clone", "package"}:
        raise UpdateError(f"unsupported source kind: {source_kind}")

    items: list[Item] = []

    add_tree(items, root / "quickshell", Path(".config/quickshell/nyvorel"))
    add_tree(items, root / "hypr", Path(".config/hypr"))
    add_tree(items, root / "matugen", Path(".config/matugen"))

    for name in ("fish", "kitty"):
        src = root / "integrations" / name
        if src.is_dir():
            add_tree(items, src, Path(f".config/{name}"))

    if source_kind == "source-clone":
        add_tree(items, root / "bin", Path(".local/bin"))
        add_tree(items, root / "dependencies", Path(".local/share/nyvorel/dependencies"))

        systemd_root = root / "systemd"
        if not systemd_root.is_dir():
            raise UpdateError("required source directory missing: systemd")

        for src in sorted(systemd_root.rglob("*")):
            if src.is_dir():
                continue
            if not (src.is_file() or src.is_symlink()):
                continue
            if "__pycache__" in src.parts or src.suffix in {".pyc", ".pyo"}:
                continue

            rel_inside = src.relative_to(systemd_root)
            name = rel_inside.name
            if name.endswith(".in"):
                name = name[:-3]
            dest_inside = rel_inside.with_name(name)
            items.append(Item(src=src, rel=Path(".config/systemd/user") / dest_inside))

        logo = root / "assets" / "nyvorel.svg"
        if not logo.is_file():
            raise UpdateError("required Nyvorel logo missing")

        items.append(
            Item(
                src=logo,
                rel=Path(".local/share/icons/hicolor/scalable/apps/nyvorel.svg"),
            )
        )

    seen: dict[str, Path] = {}
    for item in items:
        if item.rel.is_absolute() or ".." in item.rel.parts:
            raise UpdateError(f"unsafe destination path: {item.rel}")
        key = item.rel.as_posix()
        if key in seen:
            raise UpdateError(
                f"duplicate destination: {item.rel} from {seen[key]} and {item.src}"
            )
        seen[key] = item.src

        if item.src.is_symlink() and os.path.isabs(os.readlink(item.src)):
            raise UpdateError(
                f"absolute source symlink refused: {item.src} -> {os.readlink(item.src)}"
            )

    return items


def rendered_digest(item: Item, home: Path) -> dict[str, str]:
    if item.src.is_symlink():
        return {"kind": "symlink", "value": os.readlink(item.src)}

    data = item.src.read_bytes().replace(
        HOME_TOKEN_BYTES,
        str(home).encode("utf-8"),
    )
    return {
        "kind": "file",
        "value": hashlib.sha256(data).hexdigest(),
    }


def live_state(path: Path, expected: dict[str, Any]) -> str:
    if not lexists(path):
        return "missing"

    kind = expected.get("kind")
    value = expected.get("value")

    if kind == "symlink":
        return "ok" if path.is_symlink() and os.readlink(path) == value else "changed"

    if kind == "file":
        if path.is_symlink() or not path.is_file():
            return "changed"
        return "ok" if sha256_file(path) == value else "changed"

    return "invalid"


def appearance_blocks(text: str, rel: str) -> tuple[str, list[str]]:
    blocks: list[str] = []
    base = text
    for marker in LEGACY_APPEARANCE_MARKERS[rel]:
        begin = f"# >>> {marker} >>>"
        end = f"# <<< {marker} <<<"
        if base.count(begin) != base.count(end) or base.count(begin) > 1:
            raise UpdateError(f"malformed legacy appearance marker in {rel}: {marker}")
        if begin not in base:
            continue
        pattern = re.compile(r"^" + re.escape(begin) + r"\n.*?^" + re.escape(end), re.M | re.S)
        match = pattern.search(base)
        if match is None:
            raise UpdateError(f"malformed legacy appearance block in {rel}: {marker}")
        blocks.append(match.group(0))
        base = base[:match.start()] + base[match.end():]
    return re.sub(r"\n{3,}", "\n\n", base).strip(), blocks


def known_legacy_appearance_change(
    rel: str, entry: dict[str, Any], live: Path, old_manifest: dict[str, Any]
) -> bool:
    if rel not in LEGACY_APPEARANCE_MARKERS or live.is_symlink() or not live.is_file():
        return False
    if old_manifest.get("source_kind") != "source-clone":
        return False
    commit = str(old_manifest.get("source_commit") or "")
    root = Path(str(old_manifest.get("source_root") or ""))
    source_path = entry.get("source")
    if not re.fullmatch(r"[0-9a-fA-F]{40,64}", commit):
        return False
    if source_path not in {"hypr/custom/general.conf", "hypr/custom/rules.conf"}:
        return False
    proc = subprocess.run(
        ["git", "-C", str(root), "show", f"{commit}:{source_path}"],
        capture_output=True, check=False, timeout=8,
    )
    if proc.returncode != 0:
        return False
    original = proc.stdout.replace(HOME_TOKEN_BYTES, str(live.parents[3]).encode())
    if entry["installed"] != {"kind": "file", "value": hashlib.sha256(original).hexdigest()}:
        return False
    try:
        old_base, _ = appearance_blocks(original.decode("utf-8"), rel)
        live_base, _ = appearance_blocks(live.read_text(encoding="utf-8"), rel)
    except (UnicodeError, UpdateError):
        return False
    return old_base == live_base


def validate_source(
    root: Path,
    version: str,
    items: list[Item],
    source_kind: str = "source-clone",
) -> tuple[int, int]:
    if source_kind == "package":
        required = [
            root / "VERSION",
            root / "package-metadata.json",
            root / "quickshell/shell.qml",
            root / "hypr/hyprland.conf",
            root / "dependencies/arch.json",
        ]
    else:
        required = [
            root / "install.sh",
            root / "uninstall.sh",
            root / "bin/nyvorel",
            root / "bin/nyvorel-doctor",
            root / "bin/nyvorel-update",
            root / "quickshell/shell.qml",
            root / "assets/nyvorel.svg",
        ]

    missing = [str(path) for path in required if not path.exists()]
    if missing:
        raise UpdateError("candidate source is incomplete: " + ", ".join(missing))

    token_files = 0
    token_count = 0

    for item in items:
        if item.src.is_symlink():
            continue
        data = item.src.read_bytes()
        count = data.count(HOME_TOKEN_BYTES)
        if count:
            token_files += 1
            token_count += count

    if source_kind == "source-clone":
        if token_count != 29:
            raise UpdateError(
                f"portable source contract expects 29 install tokens, found {token_count}"
            )
    else:
        try:
            metadata = json.loads((root / "package-metadata.json").read_text())
        except Exception as exc:
            raise UpdateError(f"cannot parse package metadata: {exc}") from exc

        if metadata.get("schema") != 1 or metadata.get("source_kind") != "package":
            raise UpdateError("invalid Nyvorel package metadata")
        if metadata.get("upstream_version") != version:
            raise UpdateError(
                "package metadata upstream_version does not match VERSION"
            )
        if metadata.get("source_home_token_occurrences") != 29:
            raise UpdateError(
                "package metadata does not preserve the 29-token source contract"
            )

    return token_files, token_count


def package_source_commit(root: Path) -> str:
    try:
        metadata = json.loads((root / "package-metadata.json").read_text())
    except Exception:
        return ""
    value = metadata.get("source_commit")
    return str(value) if isinstance(value, str) else ""


def read_manifest(home: Path) -> tuple[Path, Path, dict[str, Any]]:
    pointer = home / ".local/state/nyvorel/current-install"
    if not pointer.is_file():
        raise UpdateError(f"current installation pointer missing: {pointer}")

    raw = pointer.read_text(errors="replace").strip()
    if not raw:
        raise UpdateError("current installation pointer is empty")

    state = Path(raw).expanduser()
    if not state.is_absolute():
        state = (pointer.parent / state).resolve(strict=False)

    manifest = state / "manifest.json" if state.is_dir() else state
    if manifest.name == "manifest.json":
        state = manifest.parent
    else:
        manifest = state / "manifest.json"

    if not manifest.is_file():
        raise UpdateError(f"installation manifest missing: {manifest}")

    data = json.loads(manifest.read_text())

    if data.get("schema") != 1:
        raise UpdateError(f"unsupported manifest schema: {data.get('schema')!r}")
    if data.get("product") != "Nyvorel":
        raise UpdateError("current manifest is not a Nyvorel installation")
    if data.get("status") != "installed":
        raise UpdateError(f"current manifest is not installed: {data.get('status')!r}")
    if Path(str(data.get("target_home", ""))).resolve(strict=False) != home:
        raise UpdateError("manifest target_home does not match requested home")
    if not isinstance(data.get("entries"), list) or not data["entries"]:
        raise UpdateError("current manifest contains no entries")

    return pointer, state, data


def clean_remote_source(root: Path) -> str:
    git_dir = root / ".git"
    if not git_dir.exists():
        raise UpdateError("--fetch requires a Git checkout")

    dirty = git_output(root, "status", "--porcelain")
    if dirty:
        raise UpdateError("--fetch refuses a dirty source checkout")

    remote = git_output(root, "remote", "get-url", "origin")
    if not remote:
        raise UpdateError("--fetch requires an origin remote")

    return remote


def github_repository(root: Path, remote: str) -> str:
    configured = git_output(root, "config", "--get", "nyvorel.githubRepository")
    if configured:
        parts = configured.strip("/").split("/")
        if len(parts) == 2 and all(parts):
            return "/".join(parts)
        raise UpdateError(
            "git config nyvorel.githubRepository must be OWNER/REPOSITORY"
        )

    path = ""
    if remote.startswith("git@github.com:"):
        path = remote.split(":", 1)[1]
    else:
        parsed = urlparse(remote)
        if parsed.hostname == "github.com":
            path = parsed.path

    path = path.strip("/")
    if path.endswith(".git"):
        path = path[:-4]

    parts = path.split("/")
    if len(parts) != 2 or not all(parts):
        raise UpdateError(
            "stable channel requires a GitHub origin remote or "
            "`git config nyvorel.githubRepository OWNER/REPOSITORY`"
        )

    return "/".join(parts)


def latest_stable_release(root: Path, remote: str) -> tuple[str, str]:
    repository = github_repository(root, remote)
    api_base = os.environ.get(
        "NYVOREL_GITHUB_API_BASE",
        "https://api.github.com",
    ).rstrip("/")
    url = f"{api_base}/repos/{repository}/releases?per_page=100"

    request = Request(
        url,
        headers={
            "Accept": "application/vnd.github+json",
            "User-Agent": "Nyvorel-Updater",
        },
    )

    try:
        with urlopen(request, timeout=20) as response:
            releases = json.load(response)
    except Exception as exc:
        raise UpdateError(
            f"cannot query stable GitHub releases for {repository}: {exc}"
        ) from exc

    if not isinstance(releases, list):
        raise UpdateError("GitHub releases response is not a list")

    candidates: list[tuple[tuple[int, int, int], str]] = []

    for release in releases:
        if not isinstance(release, dict):
            continue
        if release.get("draft") or release.get("prerelease"):
            continue

        tag = release.get("tag_name")
        if not isinstance(tag, str):
            continue

        match = STABLE_TAG_RE.fullmatch(tag)
        if not match:
            continue

        candidates.append(
            (tuple(int(value) for value in match.groups()), tag)
        )

    if not candidates:
        raise UpdateError(
            f"no non-draft, non-prerelease semantic release found for {repository}"
        )

    _, tag = max(candidates)
    return tag, tag[1:]


def clone_stable_candidate(
    root: Path,
) -> tuple[tempfile.TemporaryDirectory, Path, str, str]:
    remote = clean_remote_source(root)
    tag, version = latest_stable_release(root, remote)

    temp = tempfile.TemporaryDirectory(prefix="nyvorel-update-stable-")
    candidate = Path(temp.name)

    print(f"Source remote         : {remote}")
    print("Update channel        : stable")
    print(f"Stable release        : {tag}")
    print("Resolving immutable stable release checkout...")

    try:
        # Fetch the exact release-tag ref and peel it explicitly. This works
        # for both lightweight and annotated Git tags and avoids relying on
        # `git clone --branch <tag>` treating the tag object itself as a
        # commit on every Git version/protocol combination.
        subprocess.run(
            ["git", "-C", str(candidate), "init", "--quiet"],
            check=True,
        )
        subprocess.run(
            [
                "git",
                "-C",
                str(candidate),
                "remote",
                "add",
                "origin",
                remote,
            ],
            check=True,
        )
        subprocess.run(
            [
                "git",
                "-C",
                str(candidate),
                "fetch",
                "--quiet",
                "--depth",
                "1",
                "origin",
                f"refs/tags/{tag}:refs/tags/{tag}",
            ],
            check=True,
        )

        commit = git_output(candidate, "rev-parse", f"{tag}^{{commit}}")
        if not commit:
            raise UpdateError(
                f"cannot peel stable release tag {tag} to a commit"
            )

        subprocess.run(
            [
                "git",
                "-C",
                str(candidate),
                "checkout",
                "--quiet",
                "--detach",
                commit,
            ],
            check=True,
        )

        checked_out = git_output(candidate, "rev-parse", "HEAD")
        if checked_out != commit:
            raise UpdateError(
                f"stable release checkout mismatch for {tag}: "
                f"{checked_out or '<unknown>'} != {commit}"
            )
    except Exception:
        temp.cleanup()
        raise

    return temp, candidate, tag, version


def fetch_development_source(root: Path) -> str:
    remote = clean_remote_source(root)

    branch = git_output(root, "branch", "--show-current")
    if branch != "main":
        raise UpdateError(
            f"development channel requires source branch main, found {branch!r}"
        )

    print(f"Source remote         : {remote}")
    print("Update channel        : development")
    print("Fetching origin/main...")

    subprocess.run(
        ["git", "-C", str(root), "fetch", "--prune", "origin", "main"],
        check=True,
    )
    subprocess.run(
        ["git", "-C", str(root), "merge", "--ff-only", "origin/main"],
        check=True,
    )

    return "origin/main"


def activate_services(home: Path) -> None:
    real_home = Path.home().resolve(strict=False)
    if home != real_home:
        raise UpdateError("--activate is only allowed for the current user's real HOME")

    systemctl = shutil.which("systemctl")
    if not systemctl:
        raise UpdateError("systemctl is unavailable; update succeeded but activation cannot run")

    path_units = [
        "nyvorel-btop-style-sync.path",
        "nyvorel-dolphin-theme-sync.path",
        "nyvorel-fuzzel-style-sync.path",
        "nyvorel-kde-app-style-sync.path",
        "nyvorel-terminal-theme-sync.path",
        "nyvorel-zed-theme-sync.path",
        "nyvorel-zen-code-style-sync.path",
    ]

    subprocess.run([systemctl, "--user", "daemon-reload"], check=True)
    subprocess.run(
        [
            systemctl,
            "--user",
            "enable",
            "--now",
            *path_units,
            "nyvorel-operations-monitor.service",
        ],
        check=True,
    )

    env_names = [
        "DISPLAY",
        "WAYLAND_DISPLAY",
        "HYPRLAND_INSTANCE_SIGNATURE",
        "XDG_CURRENT_DESKTOP",
        "XDG_SESSION_TYPE",
    ]
    subprocess.run(
        [systemctl, "--user", "import-environment", *env_names],
        check=False,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )
    subprocess.run(
        [systemctl, "--user", "restart", "nyvorel-quickshell.service"],
        check=True,
    )


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        prog="nyvorel update",
        description="Safely update a manifest-backed Nyvorel installation.",
    )
    parser.add_argument(
        "--target-home",
        metavar="PATH",
        default=os.environ.get("HOME"),
        help="Update another home directory (testing/staging).",
    )
    parser.add_argument(
        "--source",
        metavar="PATH",
        help="Candidate Nyvorel source tree. Defaults to the current manifest source_root.",
    )
    parser.add_argument(
        "--package-source",
        metavar="PATH",
        help=(
            "Use an immutable pacman-owned Nyvorel payload. "
            "Normally supplied automatically by /usr/bin/nyvorel."
        ),
    )
    parser.add_argument(
        "--migrate-to-package",
        action="store_true",
        help=(
            "Explicitly migrate a source-clone manifest to package ownership. "
            "Requires --package-source."
        ),
    )
    parser.add_argument(
        "--fetch",
        action="store_true",
        help=(
            "Resolve a remote update before planning. Stable is the default "
            "channel; use --channel development to opt into origin/main."
        ),
    )
    parser.add_argument(
        "--channel",
        choices=("stable", "development"),
        help="Remote channel used with --fetch (default: stable).",
    )
    parser.add_argument(
        "--dry-run",
        action="store_true",
        help="Show the update plan without changing the installation.",
    )
    parser.add_argument(
        "--yes",
        action="store_true",
        help="Apply the planned update without an interactive confirmation.",
    )
    parser.add_argument(
        "--force-changed",
        action="store_true",
        help="Archive locally changed managed files and continue.",
    )
    parser.add_argument(
        "--allow-dirty-source",
        action="store_true",
        help="Allow an explicit/local dirty Git source checkout (not with --fetch).",
    )
    parser.add_argument(
        "--allow-downgrade",
        action="store_true",
        help=(
            "Allow a lower VERSION only for explicit/local source updates; "
            "remote stable/development channels always refuse downgrades."
        ),
    )
    activation = parser.add_mutually_exclusive_group()
    activation.add_argument(
        "--activate",
        action="store_true",
        help="Reload/restart Nyvorel services after a successful update.",
    )
    activation.add_argument(
        "--no-activate",
        action="store_true",
        help="Do not touch user services (default).",
    )
    return parser.parse_args()


def main() -> int:
    args = parse_args()

    home = Path(args.target_home).expanduser().resolve(strict=False)
    if str(home) == "/":
        raise UpdateError("refusing to use / as target home")

    pointer, old_state, old_manifest = read_manifest(home)

    old_source_kind = str(old_manifest.get("source_kind") or "source-clone")
    if old_source_kind not in {"source-clone", "package"}:
        raise UpdateError(f"unsupported current source_kind: {old_source_kind!r}")

    if args.channel and not args.fetch:
        raise UpdateError("--channel requires --fetch")
    if args.fetch and args.source:
        raise UpdateError(
            "--source selects an explicit local source and cannot be combined with --fetch"
        )
    if args.fetch and args.allow_dirty_source:
        raise UpdateError("--allow-dirty-source cannot be combined with --fetch")
    if args.fetch and args.allow_downgrade:
        raise UpdateError(
            "--allow-downgrade is not permitted for stable/development remote channels"
        )
    if args.package_source and (args.fetch or args.source):
        raise UpdateError("--package-source cannot be combined with --fetch/--source")
    if args.migrate_to_package and not args.package_source:
        raise UpdateError("--migrate-to-package requires --package-source")
    if old_source_kind == "package" and args.fetch:
        raise UpdateError(
            "package-owned Nyvorel is updated by pacman/AUR; "
            "remote --fetch must not mutate package-owned /usr content"
        )
    if old_source_kind == "package" and args.source:
        raise UpdateError(
            "package-owned Nyvorel refuses implicit conversion to an explicit source tree"
        )

    package_env = os.environ.get("NYVOREL_PACKAGE_SOURCE_ROOT")

    source_kind = "source-clone"
    stable_version: str | None = None
    stable_temp = None

    if args.package_source:
        source_kind = "package"
        if old_source_kind == "source-clone" and not args.migrate_to_package:
            raise UpdateError(
                "source-clone -> package conversion requires --migrate-to-package"
            )
        source_root = Path(args.package_source).expanduser().resolve(strict=False)
        source = source_root
        channel = "package"
        resolved_ref = str(source_root)
    elif old_source_kind == "package":
        if not package_env:
            raise UpdateError(
                "package installation requires NYVOREL_PACKAGE_SOURCE_ROOT; "
                "run the package-owned /usr/bin/nyvorel CLI"
            )
        source_kind = "package"
        source_root = Path(package_env).expanduser().resolve(strict=False)
        source = source_root
        channel = "package"
        resolved_ref = str(source_root)
    else:
        if package_env and not args.source and not args.fetch:
            raise UpdateError(
                "source-clone installation detected under package CLI; "
                "use `nyvorel install --migrate-source-clone` explicitly"
            )

        source_value = args.source or old_manifest.get("source_root")
        if not source_value:
            raise UpdateError(
                "no source tree is available; use --source /path/to/nyvorel"
            )

        source_root = Path(str(source_value)).expanduser().resolve(strict=False)
        source = source_root
        channel = "explicit-source" if args.source else "recorded-source"
        resolved_ref = str(source_root)

        if args.fetch:
            channel = args.channel or "stable"
            if channel == "stable":
                stable_temp, source, resolved_ref, stable_version = clone_stable_candidate(
                    source_root
                )
            else:
                resolved_ref = fetch_development_source(source_root)
                source = source_root

    if not source_root.is_dir():
        raise UpdateError(f"candidate source directory missing: {source_root}")

    if (source / ".git").exists():
        dirty = git_output(source, "status", "--porcelain")
        if dirty and not args.allow_dirty_source:
            raise UpdateError(
                "candidate Git checkout is dirty; commit/stash it or use --allow-dirty-source"
            )

    version_file = source / "VERSION"
    if not version_file.is_file():
        raise UpdateError(f"candidate VERSION missing: {version_file}")

    candidate_version = version_file.read_text().strip()
    candidate_semver = parse_version(candidate_version)

    if channel == "stable" and stable_version != candidate_version:
        raise UpdateError(
            f"stable release {resolved_ref} declares VERSION {candidate_version}; "
            f"expected {stable_version}"
        )

    old_version = str(old_manifest.get("version") or "0.0.0")
    old_semver = parse_version(old_version)

    if candidate_semver < old_semver and not args.allow_downgrade:
        raise UpdateError(
            f"candidate {candidate_version} is older than installed {old_version}; "
            "use --allow-downgrade only when intentional"
        )

    items = build_items(source, source_kind)
    token_files, token_count = validate_source(
        source,
        candidate_version,
        items,
        source_kind,
    )

    source_commit = (
        package_source_commit(source)
        if source_kind == "package"
        else git_output(source, "rev-parse", "HEAD")
    )
    old_commit = str(old_manifest.get("source_commit") or "")

    if (
        channel == "stable"
        and candidate_version == old_version
        and old_commit
        and source_commit != old_commit
    ):
        raise UpdateError(
            "stable channel refuses a same-version different-commit update: "
            f"{candidate_version} is installed from {old_commit}, while "
            f"{resolved_ref} resolves to {source_commit}"
        )

    old_entries: dict[str, dict[str, Any]] = {}
    for entry in old_manifest["entries"]:
        if not isinstance(entry, dict):
            raise UpdateError("current manifest contains a non-object entry")
        rel = Path(str(entry.get("destination", "")))
        if rel.is_absolute() or ".." in rel.parts:
            raise UpdateError(f"unsafe current manifest destination: {rel}")
        key = rel.as_posix()
        if key in old_entries:
            raise UpdateError(f"duplicate current manifest destination: {key}")
        if not isinstance(entry.get("installed"), dict):
            raise UpdateError(f"current manifest entry has no installed digest: {key}")
        if entry.get("ownership") == "runtime" and key not in RUNTIME_RELS:
            raise UpdateError(f"invalid runtime ownership destination: {key}")
        old_entries[key] = entry

    candidate_by_rel = {item.rel.as_posix(): item for item in items}

    drift_changed: list[str] = []
    drift_missing: list[str] = []
    invalid: list[str] = []

    for rel, entry in old_entries.items():
        if entry.get("ownership") == "runtime":
            live = home / rel
            if not lexists(live):
                drift_missing.append(rel)
            elif not live.is_file() or live.is_symlink():
                drift_changed.append(rel)
            continue
        status = live_state(home / rel, entry["installed"])
        if status == "changed":
            if rel in RUNTIME_RELS and rel in candidate_by_rel:
                continue
            if not (RUNTIME_REL in candidate_by_rel and RUNTIME_REL not in old_entries
                    and known_legacy_appearance_change(rel, entry, home / rel, old_manifest)):
                drift_changed.append(rel)
        elif status == "missing":
            drift_missing.append(rel)
        elif status == "invalid":
            invalid.append(rel)

    if invalid:
        raise UpdateError(
            "invalid current manifest digest(s): " + ", ".join(invalid[:10])
        )

    if (drift_changed or drift_missing) and not args.force_changed:
        print("ERROR: managed installation drift detected.", file=sys.stderr)
        if drift_changed:
            print("Changed:", file=sys.stderr)
            for rel in drift_changed[:30]:
                print(f"  {rel}", file=sys.stderr)
        if drift_missing:
            print("Missing:", file=sys.stderr)
            for rel in drift_missing[:30]:
                print(f"  {rel}", file=sys.stderr)
        print(
            "Refusing to update. Review the edits first, or rerun with "
            "--force-changed to archive changed files before replacement.",
            file=sys.stderr,
        )
        return 3

    retained = sorted(set(old_entries) & set(candidate_by_rel))
    added = sorted(set(candidate_by_rel) - set(old_entries))
    retired = sorted(set(old_entries) - set(candidate_by_rel))

    migrated_runtime: bytes | None = None
    if RUNTIME_REL in added and not lexists(home / RUNTIME_REL):
        runtime_seed = candidate_by_rel[RUNTIME_REL].src.read_text(encoding="utf-8")
        migrated_blocks: dict[str, str] = {}
        for rel in LEGACY_APPEARANCE_MARKERS:
            if rel not in old_entries:
                continue
            live = home / rel
            if not live.is_file() or live.is_symlink():
                continue
            _, blocks = appearance_blocks(live.read_text(encoding="utf-8"), rel)
            for block in blocks:
                marker = block.splitlines()[0]
                migrated_blocks[marker] = block
        radius_marker = "# >>> Appearance Studio: window radius >>>"
        if radius_marker in migrated_blocks:
            runtime_seed = re.sub(
                re.escape(radius_marker) + r".*?" + re.escape("# <<< Appearance Studio: window radius <<<"),
                lambda _: migrated_blocks.pop(radius_marker), runtime_seed, count=1, flags=re.S,
            )
        if migrated_blocks:
            runtime_seed = runtime_seed.rstrip() + "\n\n" + "\n\n".join(migrated_blocks.values()) + "\n"
        migrated_runtime = runtime_seed.encode("utf-8")

    content_changes: list[str] = []
    unchanged: list[str] = []

    for rel in retained:
        if rel in RUNTIME_RELS:
            unchanged.append(rel)
            continue
        candidate_digest = rendered_digest(candidate_by_rel[rel], home)
        if candidate_digest == old_entries[rel]["installed"]:
            unchanged.append(rel)
        else:
            content_changes.append(rel)

    commit_changed = bool(source_commit and source_commit != old_commit)

    if channel == "stable" and candidate_version == old_version and not old_commit:
        if content_changes or added or retired:
            raise UpdateError(
                "stable channel refuses a same-version update when the installed "
                "source commit is unknown and the managed payload differs"
            )
        commit_changed = False

    new_collisions: list[str] = []
    directory_conflicts: list[str] = []

    for rel in added:
        dest = home / rel
        if lexists(dest):
            if dest.is_dir() and not dest.is_symlink():
                directory_conflicts.append(rel)
            else:
                new_collisions.append(rel)

    if directory_conflicts:
        raise UpdateError(
            "new managed file destinations collide with directories: "
            + ", ".join(directory_conflicts[:20])
        )

    update_needed = bool(
        content_changes
        or added
        or retired
        or drift_changed
        or drift_missing
        or candidate_version != old_version
        or commit_changed
    )

    print("============================================================")
    print("NYVOREL UPDATE")
    print("============================================================")
    print(f"Target home           : {home}")
    print(f"Update channel        : {channel}")
    print(f"Resolved ref          : {resolved_ref}")
    print(f"Current version       : {old_version}")
    print(f"Candidate version     : {candidate_version}")
    print(f"Current commit        : {old_commit or '<unknown>'}")
    print(f"Candidate commit      : {source_commit or '<unknown>'}")
    print(f"Candidate source      : {source}")
    print(f"Managed old           : {len(old_entries)}")
    print(f"Managed candidate     : {len(items)}")
    print(f"Changed payload       : {len(content_changes)}")
    print(f"New managed files     : {len(added)}")
    print(f"Retired managed files : {len(retired)}")
    print(f"New collisions        : {len(new_collisions)}")
    print(f"Local changed files   : {len(drift_changed)}")
    print(f"Local missing files   : {len(drift_missing)}")
    print(f"Template files        : {token_files}")
    print(f"Template occurrences  : {token_count}")
    print(f"Force changed         : {'yes' if args.force_changed else 'no'}")
    print(f"Activate              : {'yes' if args.activate else 'no'}")
    print()

    if not update_needed:
        print("RESULT: already up to date.")
        return 0

    if args.dry_run:
        print("DRY RUN — no files or state changed.")
        if content_changes:
            print("Payload changes:")
            for rel in content_changes[:25]:
                print(f"  {rel}")
        if added:
            print("New managed files:")
            for rel in added[:25]:
                print(f"  {rel}")
        if retired:
            print("Retired managed files:")
            for rel in retired[:25]:
                print(f"  {rel}")
        return 0

    if not args.yes:
        if not sys.stdin.isatty():
            raise UpdateError(
                "update requires confirmation; rerun with --yes after reviewing --dry-run"
            )
        answer = input("Apply this update? [y/N] ").strip().lower()
        if answer not in {"y", "yes"}:
            print("Update cancelled.")
            return 0

    stamp = datetime.now().strftime("%Y%m%d-%H%M%S")
    state = home / ".local/state/nyvorel/installations" / f"{stamp}-update-{os.getpid()}"
    backup_root = state / "backup"
    transaction_root = state / "transaction-backup"
    conflicts_root = state / "update-conflicts"
    manifest_path = state / "manifest.json"

    if state.exists():
        raise UpdateError(f"update state unexpectedly exists: {state}")

    state.mkdir(parents=True)
    backup_root.mkdir(parents=True)
    transaction_root.mkdir(parents=True)
    conflicts_root.mkdir(parents=True)

    all_destinations = sorted(set(old_entries) | set(candidate_by_rel))
    snapshot_existing: set[str] = set()

    def snapshot_live() -> None:
        for rel in all_destinations:
            src = home / rel
            if not lexists(src):
                continue
            snapshot_existing.add(rel)
            copy_path(src, transaction_root / rel)

    def restore_transaction() -> None:
        for rel in reversed(all_destinations):
            dest = home / rel
            remove_path(dest)
            snapshot = transaction_root / rel
            if rel in snapshot_existing and lexists(snapshot):
                copy_path(snapshot, dest)

        pointer.parent.mkdir(parents=True, exist_ok=True)
        tmp = pointer.with_name(pointer.name + ".nyvorel-update-rollback")
        tmp.write_text(str(old_state) + "\n")
        os.replace(tmp, pointer)

    snapshot_live()

    records: list[dict[str, Any]] = []
    archived_conflicts: list[str] = []
    missing_conflicts = list(drift_missing)

    def old_baseline_for(rel: str) -> tuple[bool, Path | None]:
        entry = old_entries[rel]
        preexisting = bool(entry.get("preexisting"))
        if not preexisting:
            return False, None

        backup_value = entry.get("backup")
        if not backup_value:
            raise UpdateError(f"preexisting current entry has no backup: {rel}")

        src = old_state / str(backup_value)
        if not lexists(src):
            raise UpdateError(f"baseline backup missing for {rel}: {src}")

        return True, src

    def write_manifest(status_value: str) -> None:
        payload = {
            "schema": 1,
            "product": "Nyvorel",
            "version": candidate_version,
            "status": status_value,
            "source_kind": source_kind,
            "source_root": str(source_root),
            "source_commit": source_commit,
            "source_channel": channel,
            "target_home": str(home),
            "created_unix": int(time.time()),
            "entries": records,
            "update": {
                "from_state": str(old_state),
                "from_version": old_version,
                "from_commit": old_commit,
                "from_source_kind": old_source_kind,
                "to_source_kind": source_kind,
                "channel": channel,
                "resolved_ref": resolved_ref,
                "resolved_commit": source_commit,
                "retired_destinations": retired,
                "changed_files_archived": archived_conflicts,
                "missing_changed_files": missing_conflicts,
            },
        }
        manifest_path.write_text(json.dumps(payload, indent=2) + "\n")

    try:
        if args.force_changed:
            for rel in drift_changed:
                live = home / rel
                if lexists(live):
                    copy_path(live, conflicts_root / rel)
                    archived_conflicts.append(rel)

        # Carry the original pre-Nyvorel baseline into the new manifest.
        for rel, item in sorted(candidate_by_rel.items()):
            if rel in old_entries:
                preexisting, baseline = old_baseline_for(rel)
            else:
                live = home / rel
                preexisting = lexists(live)
                baseline = live if preexisting else None

            backup_rel: str | None = None
            if preexisting:
                assert baseline is not None
                backup_rel_path = Path("backup") / rel
                copy_path(baseline, state / backup_rel_path)
                backup_rel = backup_rel_path.as_posix()

            record = {
                "destination": rel,
                "source": str(item.src.relative_to(source)),
                "preexisting": preexisting,
                "backup": backup_rel,
                "installed": None,
            }
            if rel in RUNTIME_RELS:
                record["ownership"] = "runtime"
            records.append(record)

        write_manifest("updating")

        # Destinations retired by the candidate are restored to their original
        # pre-Nyvorel baseline (or removed if Nyvorel originally created them).
        for rel in retired:
            dest = home / rel
            preexisting, baseline = old_baseline_for(rel)
            remove_path(dest)
            if preexisting:
                assert baseline is not None
                copy_path(baseline, dest)

        # Install candidate payload.
        record_by_rel = {record["destination"]: record for record in records}

        for rel, item in sorted(candidate_by_rel.items()):
            dest = home / rel
            if rel in RUNTIME_RELS and lexists(dest):
                if not dest.is_file() or dest.is_symlink():
                    raise UpdateError(f"runtime state must be a regular file: {dest}")
                record_by_rel[rel]["installed"] = installed_digest(dest)
                write_manifest("updating")
                continue
            dest.parent.mkdir(parents=True, exist_ok=True)
            remove_path(dest)

            if item.src.is_symlink():
                os.symlink(os.readlink(item.src), dest)
            else:
                data = (migrated_runtime if rel == RUNTIME_REL and migrated_runtime is not None
                        else item.src.read_bytes()).replace(
                    HOME_TOKEN_BYTES,
                    str(home).encode("utf-8"),
                )
                tmp = dest.with_name(dest.name + ".nyvorel-update-tmp")
                remove_path(tmp)
                with tmp.open("wb") as handle:
                    handle.write(data)
                os.chmod(tmp, stat.S_IMODE(item.src.stat().st_mode))
                os.replace(tmp, dest)

            record_by_rel[rel]["installed"] = installed_digest(dest)
            write_manifest("updating")

        (home / ".config/nyvorel").mkdir(parents=True, exist_ok=True)

        unresolved: list[str] = []
        for rel, item in candidate_by_rel.items():
            if item.src.is_symlink():
                continue
            if HOME_TOKEN_BYTES not in item.src.read_bytes():
                continue
            if HOME_TOKEN_BYTES in (home / rel).read_bytes():
                unresolved.append(rel)

        if unresolved:
            raise UpdateError(
                "unresolved install token(s) after update: "
                + ", ".join(unresolved[:20])
            )

        write_manifest("installed")

        pointer.parent.mkdir(parents=True, exist_ok=True)
        pointer_tmp = pointer.with_name(pointer.name + ".nyvorel-update-tmp")
        pointer_tmp.write_text(str(state) + "\n")
        os.replace(pointer_tmp, pointer)

    except Exception:
        try:
            restore_transaction()
            write_manifest("rolled-back")
        except Exception as rollback_exc:
            print(
                f"ROLLBACK WARNING: {rollback_exc}",
                file=sys.stderr,
            )
        raise

    print("Update payload: PASS")
    print(f"Previous state : {old_state}")
    print(f"Current state  : {state}")
    print(f"Manifest       : {manifest_path}")

    if archived_conflicts:
        print(f"Archived edits : {conflicts_root}")

    if args.activate:
        try:
            activate_services(home)
        except Exception as exc:
            print(
                f"WARNING: update succeeded, but activation failed: {exc}",
                file=sys.stderr,
            )
            return 4
        print("Activation     : PASS")
    else:
        print("Activation     : skipped")

    print("RESULT: PASS")
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except UpdateError as exc:
        print(f"ERROR: {exc}", file=sys.stderr)
        raise SystemExit(1)
