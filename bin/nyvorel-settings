#!/usr/bin/env bash
set -euo pipefail

SETTINGS_QML="$HOME/.config/quickshell/nyvorel/settings.qml"
# Reopen the existing Settings window, including one closed to the tray-like
# Quickshell process. Avoid rebuilding the entire QML tree on every shortcut.
if command -v qs >/dev/null 2>&1; then
    if qs -p "$SETTINGS_QML" ipc call settings open >/dev/null 2>&1; then
        exit 0
    fi
fi

# Remove stale standalone Settings processes only.
pkill -f '^qs -p .*/settings\.qml$' 2>/dev/null || true
pkill -f '^quickshell -p .*/settings\.qml$' 2>/dev/null || true

if command -v qs >/dev/null 2>&1; then
    exec env XDG_CURRENT_DESKTOP=gnome \
        qs -p "$SETTINGS_QML"
fi

if command -v quickshell >/dev/null 2>&1; then
    exec env XDG_CURRENT_DESKTOP=gnome \
        quickshell -p "$SETTINGS_QML"
fi

for app in systemsettings gnome-control-center better-control; do
    if command -v "$app" >/dev/null 2>&1; then
        exec "$app"
    fi
done

echo "No supported Settings application found." >&2
exit 127
