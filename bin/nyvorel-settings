#!/usr/bin/env bash
set -euo pipefail

SETTINGS_QML="$HOME/.config/quickshell/nyvorel/settings.qml"
SETTINGS_SIGNAL_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/nyvorel"
SETTINGS_SIGNAL="$SETTINGS_SIGNAL_DIR/settings-open"
mkdir -p "$SETTINGS_SIGNAL_DIR"

# Reuse an already open Settings window. The process exits after its close
# animation, so a later launch starts a fresh instance.
settings_running() {
    pgrep -u "$(id -u)" -f "^(/usr/bin/)?(qs|quickshell) (-n )?-p $SETTINGS_QML$" >/dev/null
}

if settings_running; then
    printf '%s\n' "$(date +%s%N)" > "$SETTINGS_SIGNAL"
    # The previous instance may have been in its final close frame when the
    # signal arrived. Allow it to exit before deciding whether to launch anew.
    sleep 0.25
    if settings_running; then
        exit 0
    fi
fi

touch "$SETTINGS_SIGNAL"

if command -v qs >/dev/null 2>&1; then
    exec env XDG_CURRENT_DESKTOP=gnome \
        qs -n -p "$SETTINGS_QML"
fi

if command -v quickshell >/dev/null 2>&1; then
    exec env XDG_CURRENT_DESKTOP=gnome \
        quickshell -n -p "$SETTINGS_QML"
fi

for app in systemsettings gnome-control-center better-control; do
    if command -v "$app" >/dev/null 2>&1; then
        exec "$app"
    fi
done

echo "No supported Settings application found." >&2
exit 127
