#!/usr/bin/env bash
set -euo pipefail

settings_qml="${XDG_CONFIG_HOME:-$HOME/.config}/quickshell/nyvorel/settings.qml"
settings_runtime_dir="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/nyvorel"

action=open
case "${1:-}" in
    "") ;;
    --toggle) action=toggle ;;
    *) printf 'Usage: %s [--toggle]\n' "$0" >&2; exit 2 ;;
esac

for shell in qs quickshell; do
    if ! command -v "$shell" >/dev/null 2>&1; then
        continue
    fi

    # Serialize launches until Settings can receive a second shortcut press.
    mkdir -p "$settings_runtime_dir"
    exec 9>"$settings_runtime_dir/settings.lock"
    flock 9

    if "$shell" ipc -p "$settings_qml" call settings "$action" >/dev/null 2>&1; then
        exit 0
    fi

    env XDG_CURRENT_DESKTOP=gnome "$shell" -n -d -p "$settings_qml" 9>&-
    for ((attempt = 0; attempt < 40; attempt++)); do
        if "$shell" ipc -p "$settings_qml" show 2>/dev/null | grep -Fxq "target settings"; then
            exit 0
        fi
        sleep 0.05
    done
    printf 'Nyvorel Settings did not register its IPC handler.\n' >&2
    exit 1
done

for app in systemsettings gnome-control-center better-control; do
    if command -v "$app" >/dev/null 2>&1; then
        exec "$app"
    fi
done

echo "No supported Settings application found." >&2
exit 127
