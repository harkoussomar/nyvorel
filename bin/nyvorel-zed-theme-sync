#!/usr/bin/env python3
from __future__ import annotations

import json
import os
import re
import sys
from pathlib import Path

HOME = Path.home()
COLOR_JSON = Path(os.environ.get("NYVOREL_ZED_COLORS", HOME / ".local/state/quickshell/user/generated/colors.json"))
NYVOREL_CONFIG = Path(os.environ.get("NYVOREL_ZED_CONFIG", HOME / ".config/nyvorel/config.json"))
SETTINGS = Path(os.environ.get("NYVOREL_ZED_SETTINGS", HOME / ".config/zed/settings.json"))
STATE = Path(os.environ.get("NYVOREL_ZED_STATE", HOME / ".local/state/nyvorel"))
LOG = STATE / "zed-theme-sync.log"
MARK_BEGIN = "// >>> nyvorel-zed-system-theme-v1 >>>"
MARK_END = "// <<< nyvorel-zed-system-theme-v1 <<<"
HEX = re.compile(r"^#?([0-9a-fA-F]{6})(?:[0-9a-fA-F]{2})?$")


def norm(s: str) -> str:
    return re.sub(r"[^a-z0-9]", "", s.lower())


def valid_hex(v) -> str | None:
    if not isinstance(v, str):
        return None
    m = HEX.match(v.strip())
    return "#" + m.group(1).lower() if m else None


def best_color_scope(data):
    expected = {
        "background", "onbackground", "surface", "onsurface", "primary",
        "onprimary", "secondary", "tertiary", "error", "outline",
    }
    candidates = []

    def add(obj, priority):
        if not isinstance(obj, dict):
            return
        keys = {norm(k) for k, v in obj.items() if valid_hex(v)}
        score = len(keys & expected)
        candidates.append((score, priority, obj))

    add(data, 100)
    if isinstance(data, dict):
        mode = str(data.get("mode") or data.get("theme") or "").lower()
        dark_flag = data.get("is_dark")
        preferred = None
        if dark_flag is True or "dark" in mode:
            preferred = "dark"
        elif dark_flag is False or "light" in mode:
            preferred = "light"
        for key in ("colors", "current", "scheme", "dark", "light"):
            obj = data.get(key)
            bonus = 20 if key == preferred else 0
            add(obj, 80 + bonus)
    candidates.sort(key=lambda x: (x[0], x[1]), reverse=True)
    return candidates[0][2] if candidates else data


def load_colors():
    data = json.loads(COLOR_JSON.read_text(encoding="utf-8"))
    scope = best_color_scope(data)
    colors = {}
    for k, v in scope.items():
        hv = valid_hex(v)
        if hv:
            colors[norm(k)] = hv

    def pick(*names, fallback=None):
        for name in names:
            value = colors.get(norm(name))
            if value:
                return value
        if fallback is not None:
            return fallback
        raise KeyError("Missing color role: " + ", ".join(names))

    background = pick("background")
    on_background = pick("on_background", "onBackground", "on_surface", fallback=background)
    surface = pick("surface", "surface_dim", "surfaceDim", fallback=background)
    surface_low = pick("surface_container_low", "surfaceContainerLow", "surface", fallback=surface)
    surface_container = pick("surface_container", "surfaceContainer", "surface_variant", "surfaceVariant", fallback=surface_low)
    surface_high = pick("surface_container_high", "surfaceContainerHigh", "surface_container", fallback=surface_container)
    surface_highest = pick("surface_container_highest", "surfaceContainerHighest", "surface_container_high", fallback=surface_high)
    on_surface = pick("on_surface", "onSurface", "on_background", fallback=on_background)
    on_surface_variant = pick("on_surface_variant", "onSurfaceVariant", "outline", fallback=on_surface)
    primary = pick("primary", fallback=on_surface)
    on_primary = pick("on_primary", "onPrimary", "background", fallback=background)
    primary_container = pick("primary_container", "primaryContainer", "surface_container", fallback=surface_container)
    on_primary_container = pick("on_primary_container", "onPrimaryContainer", "on_surface", fallback=on_surface)
    secondary = pick("secondary", fallback=primary)
    secondary_container = pick("secondary_container", "secondaryContainer", "surface_container", fallback=surface_container)
    on_secondary_container = pick("on_secondary_container", "onSecondaryContainer", "on_surface", fallback=on_surface)
    tertiary = pick("tertiary", fallback=secondary)
    tertiary_container = pick("tertiary_container", "tertiaryContainer", "surface_container_high", fallback=surface_high)
    error = pick("error", fallback=primary)
    error_container = pick("error_container", "errorContainer", fallback=surface_container)
    on_error_container = pick("on_error_container", "onErrorContainer", "on_surface", fallback=on_surface)
    outline = pick("outline", "on_surface_variant", fallback=on_surface_variant)
    outline_variant = pick("outline_variant", "outlineVariant", "outline", fallback=outline)

    return {
        "background": background,
        "on_background": on_background,
        "surface": surface,
        "surface_low": surface_low,
        "surface_container": surface_container,
        "surface_high": surface_high,
        "surface_highest": surface_highest,
        "on_surface": on_surface,
        "on_surface_variant": on_surface_variant,
        "primary": primary,
        "on_primary": on_primary,
        "primary_container": primary_container,
        "on_primary_container": on_primary_container,
        "secondary": secondary,
        "secondary_container": secondary_container,
        "on_secondary_container": on_secondary_container,
        "tertiary": tertiary,
        "tertiary_container": tertiary_container,
        "error": error,
        "error_container": error_container,
        "on_error_container": on_error_container,
        "outline": outline,
        "outline_variant": outline_variant,
    }


def luminance(color: str) -> float:
    rgb = [int(color[i:i+2], 16) / 255 for i in (1, 3, 5)]
    def f(x):
        return x / 12.92 if x <= 0.04045 else ((x + 0.055) / 1.055) ** 2.4
    r, g, b = map(f, rgb)
    return 0.2126 * r + 0.7152 * g + 0.0722 * b


def alpha_hex(opacity: float) -> str:
    opacity = max(0.0, min(1.0, opacity))
    return f"{round(opacity * 255):02x}"


def with_alpha(color: str, opacity: float) -> str:
    return color[:7] + alpha_hex(opacity)


def mix(a: str, b: str, t: float) -> str:
    t = max(0.0, min(1.0, t))
    ar = [int(a[i:i+2], 16) for i in (1, 3, 5)]
    br = [int(b[i:i+2], 16) for i in (1, 3, 5)]
    out = [round(x * (1 - t) + y * t) for x, y in zip(ar, br)]
    return "#" + "".join(f"{x:02x}" for x in out)


def load_appearance():
    cfg = json.loads(NYVOREL_CONFIG.read_text(encoding="utf-8"))
    appearance = cfg.get("appearance", {}) if isinstance(cfg, dict) else {}
    transparency = appearance.get("transparency", {}) or {}
    radius = (appearance.get("geometry", {}) or {}).get("radius", {}) or {}
    control = radius.get("control", {}) or {}
    enabled = transparency.get("enable") is True
    automatic = transparency.get("automatic") is True
    bg_t = float(transparency.get("backgroundTransparency", 0.0) or 0.0)
    content_t = float(transparency.get("contentTransparency", 0.0) or 0.0)
    fluid = (
        enabled
        and not automatic
        and appearance.get("extraBackgroundTint") is False
        and abs(bg_t - 0.40) < 0.001
        and abs(content_t - 0.80) < 0.001
        and int(radius.get("global", -1)) == 8
        and int(control.get("value", -1)) == 4
    )
    fonts = appearance.get("fonts", {}) or {}
    return {
        "transparent": enabled,
        "background_transparency": max(0.0, min(1.0, bg_t)),
        "content_transparency": max(0.0, min(1.0, content_t)),
        "fluid": fluid,
        "ui_font": fonts.get("main") or fonts.get("title") or "",
        "mono_font": fonts.get("monospace") or "",
    }


