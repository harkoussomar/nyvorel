def skip_ws_comments(text: str, pos: int) -> int:
    n = len(text)
    while pos < n:
        if text[pos].isspace():
            pos += 1
            continue
        if text.startswith("//", pos):
            end = text.find("\n", pos + 2)
            return n if end < 0 else skip_ws_comments(text, end + 1)
        if text.startswith("/*", pos):
            end = text.find("*/", pos + 2)
            if end < 0:
                raise ValueError("unterminated block comment")
            pos = end + 2
            continue
        break
    return pos


def parse_string_end(text: str, pos: int) -> int:
    assert text[pos] == '"'
    pos += 1
    while pos < len(text):
        if text[pos] == "\\":
            pos += 2
        elif text[pos] == '"':
            return pos + 1
        else:
            pos += 1
    raise ValueError("unterminated string")


def value_end(text: str, pos: int) -> int:
    pos = skip_ws_comments(text, pos)
    if pos >= len(text):
        raise ValueError("missing value")
    ch = text[pos]
    if ch == '"':
        return parse_string_end(text, pos)
    if ch in "[{":
        open_ch = ch
        close_ch = "]" if ch == "[" else "}"
        depth = 0
        i = pos
        while i < len(text):
            if text.startswith("//", i):
                end = text.find("\n", i + 2)
                i = len(text) if end < 0 else end + 1
                continue
            if text.startswith("/*", i):
                end = text.find("*/", i + 2)
                if end < 0:
                    raise ValueError("unterminated block comment")
                i = end + 2
                continue
            if text[i] == '"':
                i = parse_string_end(text, i)
                continue
            if text[i] == open_ch:
                depth += 1
            elif text[i] == close_ch:
                depth -= 1
                if depth == 0:
                    return i + 1
            i += 1
        raise ValueError("unterminated composite value")
    i = pos
    while i < len(text) and text[i] not in ",}\n":
        i += 1
    return i


def top_level_property_span(text: str, key: str):
    i = 0
    depth = 0
    n = len(text)
    while i < n:
        if text.startswith("//", i):
            end = text.find("\n", i + 2)
            i = n if end < 0 else end + 1
            continue
        if text.startswith("/*", i):
            end = text.find("*/", i + 2)
            if end < 0:
                raise ValueError("unterminated block comment")
            i = end + 2
            continue
        ch = text[i]
        if ch == '"':
            start = i
            end = parse_string_end(text, i)
            if depth == 1:
                try:
                    parsed = json.loads(text[start:end])
                except Exception:
                    parsed = None
                j = skip_ws_comments(text, end)
                if parsed == key and j < n and text[j] == ":":
                    ve = value_end(text, j + 1)
                    k = skip_ws_comments(text, ve)
                    if k < n and text[k] == ",":
                        k += 1
                    while k < n and text[k] in " \t\r":
                        k += 1
                    if k < n and text[k] == "\n":
                        k += 1
                    return start, k
            i = end
            continue
        if ch == "{":
            depth += 1
        elif ch == "}":
            depth -= 1
        i += 1
    return None


def build_block(base_theme: str, style: dict) -> str:
    override = {base_theme: style}
    lines = [
        "  " + MARK_BEGIN,
        f'  "theme": {json.dumps(base_theme)},',
        '  "theme_overrides": ' + json.dumps(override, indent=2, ensure_ascii=False).replace("\n", "\n  ") + ",",
        "  " + MARK_END,
    ]
    return "\n".join(lines) + "\n"


def replace_managed_block(text: str, block: str) -> str:
    begin = text.find(MARK_BEGIN)
    end = text.find(MARK_END)
    if begin >= 0 or end >= 0:
        if begin < 0 or end < 0 or end < begin:
            raise ValueError("broken II Zed managed markers")
        line_start = text.rfind("\n", 0, begin) + 1
        line_end = text.find("\n", end)
        line_end = len(text) if line_end < 0 else line_end + 1
        return text[:line_start] + block + text[line_end:]

    theme_span = top_level_property_span(text, "theme")
    overrides_span = top_level_property_span(text, "theme_overrides")
    if not theme_span or not overrides_span:
        raise ValueError("could not locate top-level theme/theme_overrides settings")
    raw_start = min(theme_span[0], overrides_span[0])
    start = text.rfind("\n", 0, raw_start) + 1
    end = max(theme_span[1], overrides_span[1])
    return text[:start] + block + text[end:]


def sync_font_setting(text: str, key: str, value: str, *, before_key: str | None = None) -> str:
    if not value:
        return text
    pattern = re.compile(rf'(?m)^(\s*)"{re.escape(key)}"\s*:\s*"(?:\\.|[^"\\])*"\s*,\s*$')
    m = pattern.search(text)
    line = f'  "{key}": {json.dumps(value)},'
    if m:
        return text[:m.start()] + line + text[m.end():]
    if before_key:
        target = re.search(rf'(?m)^\s*"{re.escape(before_key)}"\s*:', text)
        if target:
            start = text.rfind("\n", 0, target.start()) + 1
            return text[:start] + line + "\n" + text[start:]
    # Insert before the top-level closing brace as a last-resort safe location.
    pos = text.rfind("}")
    if pos < 0:
        raise ValueError("settings root closing brace not found")
    return text[:pos] + line + "\n" + text[pos:]


def strip_jsonc(text: str) -> str:
    # Strip comments while preserving strings.
    out = []
    i = 0
    n = len(text)
    in_string = False
    while i < n:
        if in_string:
            ch = text[i]
            out.append(ch)
            if ch == "\\" and i + 1 < n:
                out.append(text[i + 1])
                i += 2
                continue
            if ch == '"':
                in_string = False
            i += 1
            continue
        if text[i] == '"':
            in_string = True
            out.append(text[i])
            i += 1
            continue
        if text.startswith("//", i):
            end = text.find("\n", i + 2)
            if end < 0:
                break
            out.append("\n")
            i = end + 1
            continue
        if text.startswith("/*", i):
            end = text.find("*/", i + 2)
            if end < 0:
                raise ValueError("unterminated block comment")
            # Preserve newlines for useful error locations.
            out.append("\n" * text[i:end + 2].count("\n"))
            i = end + 2
            continue
        out.append(text[i])
        i += 1

    cleaned = "".join(out)
    # Remove trailing commas outside strings.
    out2 = []
    i = 0
    n = len(cleaned)
    in_string = False
    while i < n:
        ch = cleaned[i]
        if in_string:
            out2.append(ch)
            if ch == "\\" and i + 1 < n:
                out2.append(cleaned[i + 1])
                i += 2
                continue
            if ch == '"':
                in_string = False
            i += 1
            continue
        if ch == '"':
            in_string = True
            out2.append(ch)
            i += 1
            continue
        if ch == ',':
            j = i + 1
            while j < n and cleaned[j].isspace():
                j += 1
            if j < n and cleaned[j] in '}]':
                i += 1
                continue
        out2.append(ch)
        i += 1
    return "".join(out2)


def atomic_write(path: Path, text: str):
    # Preserve the existing settings.json inode so running Zed gets a
    # normal MODIFY/CLOSE_WRITE event instead of a temp-file rename.
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("w", encoding="utf-8") as f:
        f.write(text)
        f.flush()

def main():
    STATE.mkdir(parents=True, exist_ok=True)
    c = load_colors()
    app = load_appearance()
    base_theme, style = build_override(c, app)
    block = build_block(base_theme, style)
    old = SETTINGS.read_text(encoding="utf-8")
    new = replace_managed_block(old, block)
    new = sync_font_setting(new, "ui_font_family", app.get("ui_font", ""), before_key="ui_font_size")
    new = sync_font_setting(new, "buffer_font_family", app.get("mono_font", ""))
    # Reject malformed settings before replacing the live file.
    json.loads(strip_jsonc(new))
    if new != old:
        atomic_write(SETTINGS, new)
    LOG.write_text(
        f"theme={base_theme}\nfluid={app['fluid']}\ntransparent={app['transparent']}\n"
        f"background={style['background']}\nappearance={style['background.appearance']}\n",
        encoding="utf-8",
    )
    print(f"Zed synced: {base_theme}; fluid={app['fluid']}; transparent={app['transparent']}")


if __name__ == "__main__":
    main()
