#!/usr/bin/env python3
from __future__ import annotations

import argparse
import hashlib
import json
import os
from pathlib import Path
import shutil
import subprocess
import sys
from dataclasses import asdict, dataclass
from typing import Any

SCHEMA = 1
DOCTOR_VERSION = 3
HOME_TOKEN = "@" + "HOME" + "@"
DEPENDENCY_CONTRACT_DESTINATION = ".local/share/nyvorel/dependencies/arch.json"

PATH_UNITS = [
    "nyvorel-btop-style-sync.path",
    "nyvorel-dolphin-theme-sync.path",
    "nyvorel-fuzzel-style-sync.path",
    "nyvorel-kde-app-style-sync.path",
    "nyvorel-terminal-theme-sync.path",
    "nyvorel-zed-theme-sync.path",
    "nyvorel-zen-code-style-sync.path",
]

CRITICAL_DESTINATIONS = [
    ".config/quickshell/nyvorel/shell.qml",
    ".local/bin/nyvorel",
    ".local/bin/nyvorel-doctor",
    ".local/bin/nyvorel-update",
    ".local/bin/nyvorel-bootstrap",
    ".local/bin/nyvorel-settings",
    DEPENDENCY_CONTRACT_DESTINATION,
    ".config/systemd/user/nyvorel-quickshell.service",
    ".config/systemd/user/nyvorel-operations-monitor.service",
    *[f".config/systemd/user/{unit}" for unit in PATH_UNITS],
]

TEXT_SUFFIXES = {
    "",
    ".bash",
    ".conf",
    ".fish",
    ".ini",
    ".json",
    ".path",
    ".py",
    ".qml",
    ".service",
    ".sh",
    ".toml",
    ".txt",
    ".yaml",
    ".yml",
}

VALID_STATUS = {"PASS", "WARN", "FAIL", "SKIP"}


@dataclass
class Check:
    id: str
    status: str
    title: str
    detail: str
    fix: str | None = None

    def __post_init__(self) -> None:
        if self.status not in VALID_STATUS:
            raise ValueError(f"invalid check status: {self.status}")


class Doctor:
    def __init__(
        self,
        home: Path,
        *,
        deep: bool,
        session_checks: bool,
        dependency_checks: bool,
        strict: bool,
    ) -> None:
        self.home = home
        self.deep = deep
        self.session_checks = session_checks
        self.dependency_checks = dependency_checks
        self.strict = strict
        self.checks: list[Check] = []
        self.manifest: dict[str, Any] | None = None
        self.manifest_path: Path | None = None
        self.source_kind = "source-clone"
        self.package_public_cli = Path(
            os.environ.get("NYVOREL_PACKAGE_PUBLIC_CLI", "/usr/bin/nyvorel")
        )
        self.package_helper_root = Path(
            os.environ.get("NYVOREL_PACKAGE_HELPER_ROOT", "/usr/lib/nyvorel/bin")
        )
        self.package_unit_root = Path(
            os.environ.get("NYVOREL_PACKAGE_UNIT_ROOT", "/usr/lib/systemd/user")
        )
        self.package_dependency_contract = os.environ.get(
            "NYVOREL_PACKAGE_DEPENDENCY_CONTRACT"
        )
        self.dependency_contract: dict[str, Any] | None = None
        self.dependency_report: dict[str, Any] = {
            "enabled": dependency_checks,
            "contract": {"status": "unknown"},
            "required": {"status": "unknown", "total": 0, "satisfied": 0, "missing": []},
            "optional": {"status": "unknown", "total": 0, "satisfied": 0, "missing": []},
        }

    def add(
        self,
        check_id: str,
        status: str,
        title: str,
        detail: str,
        fix: str | None = None,
    ) -> None:
        self.checks.append(Check(check_id, status, title, detail, fix))

    @staticmethod
    def run_command(args: list[str]) -> subprocess.CompletedProcess[str]:
        return subprocess.run(
            args,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            check=False,
        )

    @staticmethod
    def sha256_file(path: Path) -> str:
        digest = hashlib.sha256()
        with path.open("rb") as handle:
            for chunk in iter(lambda: handle.read(1024 * 1024), b""):
                digest.update(chunk)
        return digest.hexdigest()

    @staticmethod
    def lexists(path: Path) -> bool:
        return os.path.lexists(path)

    def check_platform(self) -> None:
        os_release = Path("/etc/os-release")
        distro = "unknown"
        if os_release.is_file():
            values: dict[str, str] = {}
            for raw in os_release.read_text(errors="replace").splitlines():
                if "=" not in raw:
                    continue
                key, value = raw.split("=", 1)
                values[key] = value.strip().strip('"')
            distro = values.get("ID", "unknown")

        if distro == "arch":
            self.add(
                "platform.arch",
                "PASS",
                "Target platform",
                "Arch Linux detected.",
            )
        else:
            self.add(
                "platform.arch",
                "WARN",
                "Target platform",
                f"Detected {distro}; Nyvorel targets Arch Linux.",
                "Run Nyvorel on its supported Arch Linux target for production use.",
            )

    def check_installation_files(self) -> None:
        shell = self.home / ".config/quickshell/nyvorel/shell.qml"

        if self.source_kind == "package":
            required = [
                shell,
                self.package_public_cli,
                self.package_helper_root / "nyvorel-doctor",
                self.package_helper_root / "nyvorel-update",
                self.package_helper_root / "nyvorel-bootstrap",
                self.package_helper_root / "nyvorel-settings",
                self.package_helper_root / "nyvorel-package-install",
            ]
            missing = [str(path) for path in required if not path.is_file()]

            if missing:
                self.add(
                    "install.core",
                    "FAIL",
                    "Installed core",
                    "Missing package/user core: " + ", ".join(missing),
                    "Reinstall the Nyvorel Arch package, then sync user materialization.",
                )
            else:
                self.add(
                    "install.core",
                    "PASS",
                    "Installed core",
                    "Package CLI/helpers and user shell materialization are present.",
                )

            expected = [
                "nyvorel-quickshell.service",
                "nyvorel-operations-monitor.service",
                *PATH_UNITS,
            ]
            absent = [
                name for name in expected
                if not (self.package_unit_root / name).is_file()
            ]
            if absent:
                self.add(
                    "install.systemd-files",
                    "FAIL",
                    "systemd unit files",
                    f"{len(absent)} package-provided user unit(s) missing: "
                    + ", ".join(absent),
                    "Reinstall the Nyvorel Arch package.",
                )
            else:
                self.add(
                    "install.systemd-files",
                    "PASS",
                    "systemd unit files",
                    f"All {len(expected)} package-provided user units are present.",
                )

            local_bin = self.home / ".local/bin"
            stale = [self.home / ".local/bin/nyvorel"]
            if local_bin.is_dir():
                stale.extend(sorted(local_bin.glob("nyvorel-*")))
            stale = [path for path in stale if path.exists()]

            self.add(
                "package.shadowing",
                "WARN" if stale else "PASS",
                "Package CLI shadowing",
                (
                    "Legacy user helpers can shadow package-owned /usr paths: "
                    + ", ".join(str(path) for path in stale[:8])
                    if stale
                    else "No legacy ~/.local/bin/nyvorel* helpers shadow package ownership."
                ),
                (
                    "Use `/usr/bin/nyvorel install --migrate-source-clone --yes` "
                    "for an explicit source-clone migration."
                    if stale
                    else None
                ),
            )
        else:
            cli = self.home / ".local/bin/nyvorel"
            doctor = self.home / ".local/bin/nyvorel-doctor"
            updater = self.home / ".local/bin/nyvorel-update"
            bootstrap = self.home / ".local/bin/nyvorel-bootstrap"

            missing = [
                str(path.relative_to(self.home))
                for path in (shell, cli, doctor, updater, bootstrap)
                if not path.is_file()
            ]

            if missing:
                self.add(
                    "install.core",
                    "FAIL",
                    "Installed core",
                    "Missing: " + ", ".join(missing),
                    "Install/reinstall Nyvorel from the public source tree.",
                )
            else:
                self.add(
                    "install.core",
                    "PASS",
                    "Installed core",
                    "Shell, CLI, doctor, update helper, and bootstrap planner are present.",
                )

            systemd_dir = self.home / ".config/systemd/user"
            expected = [
                "nyvorel-quickshell.service",
                "nyvorel-operations-monitor.service",
                *PATH_UNITS,
            ]
            absent = [name for name in expected if not (systemd_dir / name).is_file()]

            if absent:
                self.add(
                    "install.systemd-files",
                    "FAIL",
                    "systemd unit files",
                    f"{len(absent)} required unit file(s) missing: " + ", ".join(absent),
                    "Reinstall Nyvorel to rematerialize the systemd user units.",
                )
            else:
                self.add(
                    "install.systemd-files",
                    "PASS",
                    "systemd unit files",
                    f"All {len(expected)} required user-unit files are present.",
                )

        config_dir = self.home / ".config/nyvorel"
        self.add(
            "runtime.config-dir",
            "PASS" if config_dir.is_dir() else "WARN",
            "Runtime config directory",
            (
                f"{config_dir} exists."
                if config_dir.is_dir()
                else f"{config_dir} is missing."
            ),
            None if config_dir.is_dir() else "Start/install Nyvorel once so runtime config can be initialized.",
        )

    def load_manifest(self) -> None:
        current = self.home / ".local/state/nyvorel/current-install"

        if not current.is_file():
            self.add(
                "manifest.pointer",
                "WARN",
                "Installation manifest pointer",
                f"{current} does not exist.",
                "Install Nyvorel through install.sh so recovery state is recorded.",
            )
            return

        raw = current.read_text(errors="replace").strip()
        if not raw:
            self.add(
                "manifest.pointer",
                "FAIL",
                "Installation manifest pointer",
                "current-install is empty.",
                "Repair or reinstall the Nyvorel installation state.",
            )
            return

        manifest = Path(raw).expanduser()
        if not manifest.is_absolute():
            manifest = (current.parent / manifest).resolve(strict=False)
        if manifest.is_dir():
            manifest = manifest / "manifest.json"

        if not manifest.is_file():
            self.add(
                "manifest.pointer",
                "FAIL",
                "Installation manifest pointer",
                f"Manifest is missing: {manifest}",
                "Recover the referenced state directory or reinstall Nyvorel.",
            )
            return

        try:
            data = json.loads(manifest.read_text())
        except Exception as exc:
            self.add(
                "manifest.parse",
                "FAIL",
                "Installation manifest",
                f"Cannot parse {manifest}: {exc}",
                "Restore a valid manifest or reinstall Nyvorel.",
            )
            return

        errors: list[str] = []
        if data.get("schema") != 1:
            errors.append(f"schema={data.get('schema')!r}")
        if data.get("product") != "Nyvorel":
            errors.append(f"product={data.get('product')!r}")
        if data.get("status") != "installed":
            errors.append(f"status={data.get('status')!r}")

        try:
            target = Path(str(data.get("target_home", ""))).resolve(strict=False)
        except Exception:
            target = Path("/")
        if target != self.home:
            errors.append(f"target_home={target}")

        entries = data.get("entries")
        if not isinstance(entries, list) or not entries:
            errors.append("entries missing/empty")

        if errors:
            self.add(
                "manifest.state",
                "FAIL",
                "Installation manifest",
                "Invalid state: " + "; ".join(errors),
                "Use the installation/recovery tooling to repair the recorded state.",
            )
            return

        source_kind = str(data.get("source_kind") or "source-clone")
        if source_kind not in {"source-clone", "package"}:
            self.add(
                "manifest.source-kind",
                "FAIL",
                "Installation source kind",
                f"Unsupported source_kind={source_kind!r}.",
                "Repair/reinstall using a supported Nyvorel lifecycle.",
            )
            return

        self.manifest = data
        self.manifest_path = manifest
        self.source_kind = source_kind
        source_commit = data.get("source_commit") or "unknown"

        self.add(
            "manifest.state",
            "PASS",
            "Installation manifest",
            f"{len(entries)} managed entries; source kind {source_kind}; source commit {source_commit}.",
        )

    def _entry_matches(self, entry: dict[str, Any]) -> tuple[str, str]:
        rel = Path(str(entry.get("destination", "")))
        if rel.is_absolute() or ".." in rel.parts:
            return "invalid", rel.as_posix()

        dest = self.home / rel
        installed = entry.get("installed")
        if not isinstance(installed, dict):
            return "invalid", rel.as_posix()

        if not self.lexists(dest):
            return "missing", rel.as_posix()

        if entry.get("ownership") == "runtime":
            if rel.as_posix() not in {
                ".config/hypr/custom/appearance-runtime.conf",
                ".config/hypr/hyprland/colors.conf",
                ".config/hypr/hyprlock/colors.conf",
            }:
                return "invalid", rel.as_posix()
            return ("ok" if dest.is_file() and not dest.is_symlink() else "changed"), rel.as_posix()

        kind = installed.get("kind")
        expected = installed.get("value")

        if kind == "symlink":
            if dest.is_symlink() and os.readlink(dest) == expected:
                return "ok", rel.as_posix()
            return "changed", rel.as_posix()

        if kind == "file":
            if (
                dest.is_file()
                and not dest.is_symlink()
                and self.sha256_file(dest) == expected
            ):
                return "ok", rel.as_posix()
            return "changed", rel.as_posix()

        return "invalid", rel.as_posix()

    def check_manifest_integrity(self) -> None:
        if self.manifest is None:
            self.add(
                "manifest.integrity",
                "SKIP",
                "Managed-file integrity",
                "No valid installed manifest is available.",
            )
            return

        entries = self.manifest["entries"]
        by_destination = {
            str(entry.get("destination")): entry
            for entry in entries
            if isinstance(entry, dict)
        }

        if self.deep:
            selected = list(by_destination.values())
            scope = "all managed entries"
        else:
            critical_destinations = (
                [
                    ".config/quickshell/nyvorel/shell.qml",
                    ".config/hypr/hyprland.conf",
                ]
                if self.source_kind == "package"
                else CRITICAL_DESTINATIONS
            )
            selected = [
                by_destination[path]
                for path in critical_destinations
                if path in by_destination
            ]
            missing_contract = [
                path for path in critical_destinations if path not in by_destination
            ]
            if missing_contract:
                self.add(
                    "manifest.contract",
                    "FAIL",
                    "Manifest critical entries",
                    "Critical destination(s) absent from manifest: "
                    + ", ".join(missing_contract),
                    "Reinstall Nyvorel from a complete source tree.",
                )
            else:
                self.add(
                    "manifest.contract",
                    "PASS",
                    "Manifest critical entries",
                    f"All {len(critical_destinations)} critical destinations are recorded.",
                )
            scope = "critical managed entries"

        states = {"ok": [], "changed": [], "missing": [], "invalid": []}
        for entry in selected:
            status, rel = self._entry_matches(entry)
            states[status].append(rel)

        if states["invalid"]:
            self.add(
                "manifest.integrity",
                "FAIL",
                "Managed-file integrity",
                f"{len(states['invalid'])} invalid manifest entry/entries.",
                "Repair the installation state before recovery or updating.",
            )
            return

        if states["missing"]:
            detail = (
                f"{len(states['missing'])} missing, "
                f"{len(states['changed'])} changed across {scope}."
            )
            self.add(
                "manifest.integrity",
                "FAIL",
                "Managed-file integrity",
                detail + " Missing: " + ", ".join(states["missing"][:8]),
                "Reinstall/repair missing managed files; review user edits before recovery.",
            )
            return

        if states["changed"]:
            self.add(
                "manifest.integrity",
                "WARN",
                "Managed-file integrity",
                (
                    f"{len(states['changed'])} changed across {scope}; "
                    f"{len(states['ok'])} still match. Changed: "
                    + ", ".join(states["changed"][:8])
                ),
                "Review intentional edits before uninstall/update; recovery will protect them.",
            )
            return

        self.add(
            "manifest.integrity",
            "PASS",
            "Managed-file integrity",
            f"{len(states['ok'])} {scope} match the installation manifest.",
        )

    def check_materialization(self) -> None:
        if self.manifest is None:
            self.add(
                "install.materialization",
                "SKIP",
                "Install-time materialization",
                "No valid manifest is available.",
            )
            return

        unresolved: list[str] = []
        inspected = 0

        for entry in self.manifest["entries"]:
            if not isinstance(entry, dict):
                continue
            rel = Path(str(entry.get("destination", "")))
            if rel.is_absolute() or ".." in rel.parts:
                continue
            dest = self.home / rel
            if (
                not dest.is_file()
                or dest.is_symlink()
                or dest.suffix.lower() not in TEXT_SUFFIXES
            ):
                continue

            try:
                data = dest.read_bytes()
            except OSError:
                continue

            inspected += 1
            if HOME_TOKEN.encode() in data:
                unresolved.append(rel.as_posix())

        if unresolved:
            self.add(
                "install.materialization",
                "FAIL",
                "Install-time materialization",
                f"Unresolved {HOME_TOKEN} token(s): " + ", ".join(unresolved[:8]),
                "Reinstall from a valid Nyvorel source tree.",
            )
        else:
            self.add(
                "install.materialization",
                "PASS",
                "Install-time materialization",
                f"No unresolved home token found across {inspected} text-like managed files.",
            )

    def load_dependency_contract(self) -> None:
        path = (
            Path(self.package_dependency_contract).expanduser().resolve(strict=False)
            if self.source_kind == "package" and self.package_dependency_contract
            else (
                Path(str(self.manifest.get("source_root"))) / "dependencies/arch.json"
                if self.source_kind == "package" and self.manifest is not None
                else self.home / DEPENDENCY_CONTRACT_DESTINATION
            )
        )
        self.dependency_report["contract"] = {
            "status": "FAIL",
            "path": str(path),
            "schema": None,
        }

        if not path.is_file():
            self.add(
                "dependencies.contract",
                "FAIL",
                "Dependency contract",
                f"Installed dependency contract is missing: {path}",
                "Update/reinstall Nyvorel so the versioned dependency contract is installed.",
            )
            return

        try:
            data = json.loads(path.read_text())
        except Exception as exc:
            self.add(
                "dependencies.contract",
                "FAIL",
                "Dependency contract",
                f"Cannot parse {path}: {exc}",
                "Update/reinstall Nyvorel from a source tree with a valid dependency contract.",
            )
            return

        errors: list[str] = []
        if data.get("schema") != 2:
            errors.append(f"schema={data.get('schema')!r}")
        if data.get("product") != "Nyvorel":
            errors.append(f"product={data.get('product')!r}")

        for class_name in ("required", "optional", "test-only"):
            entries = data.get(class_name)
            if not isinstance(entries, list) or not entries:
                errors.append(f"{class_name} missing/empty")
                continue
            for entry in entries:
                if not isinstance(entry, dict):
                    errors.append(f"{class_name} contains non-object entry")
                    break
                if not isinstance(entry.get("id"), str):
                    errors.append(f"invalid {class_name} dependency id")
                    break

                command_selectors = [
                    key
                    for key in ("commands_any_of", "commands_all_of", "files_any_of", "files_all_of")
                    if isinstance(entry.get(key), list) and entry.get(key)
                ]
                package_selectors = [
                    key
                    for key in ("arch_packages_any_of", "arch_packages_all_of")
                    if isinstance(entry.get(key), list) and entry.get(key)
                ]

                if len(command_selectors) != 1 or len(package_selectors) != 1:
                    errors.append(f"invalid selector contract: {entry.get('id')!r}")
                    break

                commands = entry[command_selectors[0]]
                packages = entry[package_selectors[0]]
                if command_selectors[0].startswith("files_") and not all(
                    isinstance(value, str) and Path(value).is_absolute() and ".." not in Path(value).parts
                    for value in commands
                ):
                    errors.append(f"invalid runtime file paths: {entry.get('id')!r}")
                    break
                if (
                    not all(isinstance(value, str) and value for value in commands)
                    or not all(isinstance(value, str) and value for value in packages)
                ):
                    errors.append(f"invalid {class_name} entry: {entry.get('id')!r}")
                    break
        if errors:
            self.add(
                "dependencies.contract",
                "FAIL",
                "Dependency contract",
                "Invalid contract: " + "; ".join(errors[:8]),
                "Update/reinstall Nyvorel from a source tree with a valid dependency contract.",
            )
            return

        self.dependency_contract = data
        counts = {
            class_name: len(data[class_name])
            for class_name in ("required", "optional", "test-only")
        }
        self.dependency_report["contract"] = {
            "status": "PASS",
            "path": str(path),
            "schema": data["schema"],
            "counts": counts,
        }
        self.add(
            "dependencies.contract",
            "PASS",
            "Dependency contract",
            (
                f"schema={data['schema']}; required={counts['required']}; "
                f"optional={counts['optional']}; test-only={counts['test-only']}."
            ),
        )

    @staticmethod
    def _dependency_result(entry: dict[str, Any]) -> dict[str, Any]:
        file_probe = "files_any_of" in entry or "files_all_of" in entry
        if file_probe:
            command_mode = "all" if "files_all_of" in entry else "any"
            commands = list(entry[f"files_{command_mode}_of"])
        elif isinstance(entry.get("commands_all_of"), list):
            command_mode = "all"
            commands = list(entry["commands_all_of"])
        else:
            command_mode = "any"
            commands = list(entry["commands_any_of"])

        if isinstance(entry.get("arch_packages_all_of"), list):
            package_mode = "all"
            packages = list(entry["arch_packages_all_of"])
        else:
            package_mode = "any"
            packages = list(entry["arch_packages_any_of"])

        found = [
            {"command": command, "path": path}
            for command in commands
            if (path := ((command if Path(command).is_file() else None) if file_probe else shutil.which(command))) is not None
        ]
        found_names = {item["command"] for item in found}
        missing_commands = [
            command for command in commands if command not in found_names
        ]
        satisfied = bool(found) if command_mode == "any" else not missing_commands

        return {
            "id": entry["id"],
            "probe_kind": "file" if file_probe else "command",
            "satisfied": satisfied,
            "command_mode": command_mode,
            "commands": commands,
            "found": found,
            "missing_commands": missing_commands,
            "package_mode": package_mode,
            "package_hints": packages,
            **(
                {"feature": entry["feature"]}
                if isinstance(entry.get("feature"), str)
                else {"reason": entry.get("reason", "")}
            ),
        }

    @staticmethod
    def _missing_dependency_detail(items: list[dict[str, Any]]) -> str:
        parts = []
        for item in items[:10]:
            joiner = "+" if item["command_mode"] == "all" else "/"
            commands = joiner.join(item["commands"])
            package_joiner = "+" if item["package_mode"] == "all" else "/"
            packages = package_joiner.join(item["package_hints"])
            parts.append(f"{item['id']} ({commands}; package hint: {packages})")
        suffix = "" if len(items) <= 10 else f"; +{len(items) - 10} more"
        return ", ".join(parts) + suffix
    def check_dependencies(self) -> None:
        if self.dependency_contract is None:
            self.dependency_report["required"]["status"] = "SKIP"
            self.dependency_report["optional"]["status"] = "SKIP"
            self.add(
                "dependencies.required",
                "SKIP",
                "Required dependencies",
                "Dependency checks unavailable because the installed contract is invalid/missing.",
            )
            self.add(
                "dependencies.optional",
                "SKIP",
                "Optional feature dependencies",
                "Dependency checks unavailable because the installed contract is invalid/missing.",
            )
            return

        required_entries = self.dependency_contract["required"]
        optional_entries = self.dependency_contract["optional"]

        if not self.dependency_checks:
            self.dependency_report["required"] = {
                "status": "SKIP",
                "total": len(required_entries),
                "satisfied": 0,
                "missing": [],
            }
            self.dependency_report["optional"] = {
                "status": "SKIP",
                "total": len(optional_entries),
                "satisfied": 0,
                "missing": [],
            }
            self.add(
                "dependencies.required",
                "SKIP",
                "Required dependencies",
                "Runtime dependency probing is disabled for this diagnostic mode.",
                "Run `nyvorel doctor --dependencies` to force a read-only dependency preflight.",
            )
            self.add(
                "dependencies.optional",
                "SKIP",
                "Optional feature dependencies",
                "Runtime dependency probing is disabled for this diagnostic mode.",
                "Run `nyvorel doctor --dependencies` to inspect optional feature availability.",
            )
            return

        required = [self._dependency_result(entry) for entry in required_entries]
        optional = [self._dependency_result(entry) for entry in optional_entries]
        missing_required = [item for item in required if not item["satisfied"]]
        missing_optional = [item for item in optional if not item["satisfied"]]

        self.dependency_report["required"] = {
            "status": "FAIL" if missing_required else "PASS",
            "total": len(required),
            "satisfied": len(required) - len(missing_required),
            "missing": missing_required,
        }
        self.dependency_report["optional"] = {
            "status": "WARN" if missing_optional else "PASS",
            "total": len(optional),
            "satisfied": len(optional) - len(missing_optional),
            "missing": missing_optional,
        }

        if missing_required:
            self.add(
                "dependencies.required",
                "FAIL",
                "Required dependencies",
                (
                    f"{len(missing_required)}/{len(required)} required dependency "
                    f"group(s) missing: {self._missing_dependency_detail(missing_required)}"
                ),
                "Install the missing required Arch package/provider(s), then rerun doctor.",
            )
        else:
            self.add(
                "dependencies.required",
                "PASS",
                "Required dependencies",
                f"All {len(required)} required dependency groups are available on PATH.",
            )

        if missing_optional:
            self.add(
                "dependencies.optional",
                "WARN",
                "Optional feature dependencies",
                (
                    f"{len(missing_optional)}/{len(optional)} optional dependency "
                    f"group(s) unavailable: {self._missing_dependency_detail(missing_optional)}"
                ),
                "Install only the optional package(s) for features you intend to use.",
            )
        else:
            self.add(
                "dependencies.optional",
                "PASS",
                "Optional feature dependencies",
                f"All {len(optional)} optional dependency groups are available on PATH.",
            )

    def check_config(self) -> None:
        config = self.home / ".config/nyvorel/config.json"
        if not config.exists():
            self.add(
                "runtime.config-json",
                "WARN",
                "Runtime configuration",
                f"{config} does not exist yet.",
                "Open/start Nyvorel so its runtime configuration can be created.",
            )
            return

        try:
            data = json.loads(config.read_text())
        except Exception as exc:
            self.add(
                "runtime.config-json",
                "FAIL",
                "Runtime configuration",
                f"Invalid JSON: {exc}",
                "Repair config.json or restore a known-good runtime configuration.",
            )
            return

        if not isinstance(data, dict):
            self.add(
                "runtime.config-json",
                "FAIL",
                "Runtime configuration",
                "config.json root is not a JSON object.",
                "Repair config.json.",
            )
            return

        self.add(
            "runtime.config-json",
            "PASS",
            "Runtime configuration",
            f"Valid JSON object with {len(data)} top-level key(s).",
        )

    def check_session(self) -> None:
        if not self.session_checks:
            self.add(
                "session.environment",
                "SKIP",
                "Desktop session",
                "Session checks disabled or alternate home is being inspected.",
            )
            self.add(
                "session.systemd",
                "SKIP",
                "systemd user services",
                "Session checks disabled or alternate home is being inspected.",
            )
            self.add(
                "session.hyprland",
                "SKIP",
                "Hyprland",
                "Session checks disabled or alternate home is being inspected.",
            )
            return

        session_type = os.environ.get("XDG_SESSION_TYPE", "")
        desktop = os.environ.get("XDG_CURRENT_DESKTOP", "")
        signature = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE", "")

        env_parts = [
            f"XDG_SESSION_TYPE={session_type or '<unset>'}",
            f"XDG_CURRENT_DESKTOP={desktop or '<unset>'}",
            f"HYPRLAND_INSTANCE_SIGNATURE={'set' if signature else 'unset'}",
        ]

        if session_type == "wayland" and (
            "hyprland" in desktop.lower() or bool(signature)
        ):
            self.add(
                "session.environment",
                "PASS",
                "Desktop session",
                "; ".join(env_parts),
            )
        else:
            self.add(
                "session.environment",
                "WARN",
                "Desktop session",
                "; ".join(env_parts),
                "Run doctor inside the active Hyprland/Wayland session for full diagnostics.",
            )

        qs_binary = shutil.which("qs") or shutil.which("quickshell")
        if qs_binary:
            self.add(
                "session.quickshell-binary",
                "PASS",
                "Quickshell binary",
                qs_binary,
            )
        else:
            self.add(
                "session.quickshell-binary",
                "FAIL",
                "Quickshell binary",
                "Neither qs nor quickshell is available on PATH.",
                "Install Quickshell and ensure its executable is on PATH.",
            )

        systemctl = shutil.which("systemctl")
        if not systemctl:
            self.add(
                "session.systemd",
                "FAIL",
                "systemd user services",
                "systemctl is unavailable.",
                "Use Nyvorel on its supported systemd-based Arch Linux target.",
            )
        else:
            probe = self.run_command([systemctl, "--user", "show-environment"])
            if probe.returncode != 0:
                self.add(
                    "session.systemd",
                    "WARN",
                    "systemd user services",
                    "User manager is not reachable from this context.",
                    "Run doctor from the logged-in graphical user session.",
                )
            else:
                quickshell = self.run_command(
                    [systemctl, "--user", "is-active", "nyvorel-quickshell.service"]
                )
                monitor = self.run_command(
                    [systemctl, "--user", "is-active", "nyvorel-operations-monitor.service"]
                )

                q_state = quickshell.stdout.strip() or "unknown"
                m_state = monitor.stdout.strip() or "unknown"

                enabled = 0
                active = 0
                for unit in PATH_UNITS:
                    if (
                        self.run_command(
                            [systemctl, "--user", "is-enabled", unit]
                        ).stdout.strip()
                        == "enabled"
                    ):
                        enabled += 1
                    if (
                        self.run_command(
                            [systemctl, "--user", "is-active", unit]
                        ).stdout.strip()
                        == "active"
                    ):
                        active += 1

                status = (
                    "PASS"
                    if q_state == "active"
                    and m_state == "active"
                    and enabled == len(PATH_UNITS)
                    and active == len(PATH_UNITS)
                    else "WARN"
                )
                self.add(
                    "session.systemd",
                    status,
                    "systemd user services",
                    (
                        f"quickshell={q_state}; operations-monitor={m_state}; "
                        f"path-units enabled={enabled}/{len(PATH_UNITS)}, "
                        f"active={active}/{len(PATH_UNITS)}"
                    ),
                    (
                        None
                        if status == "PASS"
                        else "Activate Nyvorel services or inspect systemctl --user status for inactive units."
                    ),
                )

        hyprctl = shutil.which("hyprctl")
        if not hyprctl:
            self.add(
                "session.hyprland",
                "FAIL",
                "Hyprland",
                "hyprctl is unavailable on PATH.",
                "Install Hyprland and run doctor in the target desktop environment.",
            )
        elif not signature:
            self.add(
                "session.hyprland",
                "WARN",
                "Hyprland",
                "hyprctl exists, but no active Hyprland instance signature is visible.",
                "Run doctor inside the active Hyprland session.",
            )
        else:
            proc = self.run_command([hyprctl, "configerrors"])
            errors = proc.stdout.strip()

            if proc.returncode != 0:
                self.add(
                    "session.hyprland",
                    "WARN",
                    "Hyprland",
                    f"hyprctl configerrors exited {proc.returncode}: {errors[:300]}",
                    "Check the active Hyprland session and socket environment.",
                )
            elif errors:
                self.add(
                    "session.hyprland",
                    "FAIL",
                    "Hyprland",
                    "Configuration errors reported: " + errors[:500],
                    "Resolve Hyprland configuration errors before continuing.",
                )
            else:
                self.add(
                    "session.hyprland",
                    "PASS",
                    "Hyprland",
                    "No configuration errors reported.",
                )

    def check_appearance_runtime(self) -> None:
        if not self.dependency_checks:
            self.add("appearance.runtime", "SKIP", "Appearance generation runtime",
                     "Use --dependencies to check color templates and Python modules.")
            return

        # Inspect the requested home, never borrow the maintainer's environment
        # when diagnosing another installation.
        current_home = self.home == Path.home().resolve(strict=False)
        config_home = Path(os.environ.get("XDG_CONFIG_HOME", self.home / ".config")) if current_home else self.home / ".config"
        env_root = self.home / ".local/state/quickshell/.venv"
        if current_home and os.environ.get("NYVOREL_VIRTUAL_ENV"):
            env_root = Path(os.environ["NYVOREL_VIRTUAL_ENV"]).expanduser()
        interpreter = env_root / "bin/python"
        matugen_config = config_home / "matugen/config.toml"
        problems = []
        try:
            system_pillow = subprocess.run(
                ["python3", "-c", "import PIL"],
                text=True, capture_output=True, timeout=10, check=False,
            )
            if system_pillow.returncode:
                problems.append("System python-pillow is unavailable")
        except (OSError, subprocess.TimeoutExpired):
            problems.append("System python-pillow could not be checked")
        if not matugen_config.is_file():
            problems.append(f"Missing Matugen configuration: {matugen_config}")
        else:
            try:
                import tomllib
                data = tomllib.loads(matugen_config.read_text())
                templates = data.get("templates", {})
                if not templates:
                    problems.append("Matugen has no output templates")
                for name, template in templates.items():
                    raw = str(template.get("input_path", ""))
                    if raw.startswith("~/"):
                        path = self.home / raw[2:]
                    else:
                        path = Path(raw)
                        if not path.is_absolute():
                            path = matugen_config.parent / path
                    if not raw or not path.is_file():
                        problems.append(f"Missing Matugen template: {name}")
            except (OSError, ValueError, TypeError, AttributeError) as exc:
                problems.append(f"Cannot read Matugen templates: {exc}")

        if not interpreter.is_file() or not os.access(interpreter, os.X_OK):
            problems.append(f"Missing color Python interpreter: {interpreter}")
        else:
            try:
                result = subprocess.run(
                    [str(interpreter), "-c", "import PIL, materialyoucolor"],
                    text=True, capture_output=True, timeout=15, check=False,
                )
                if result.returncode:
                    problems.append("Color Python modules unavailable: " + (result.stderr or result.stdout)[-500:].strip())
            except (OSError, subprocess.TimeoutExpired) as exc:
                problems.append(f"Color Python probe failed: {exc}")

        self.add(
            "appearance.runtime", "FAIL" if problems else "PASS", "Appearance generation runtime",
            "; ".join(problems) if problems else "Matugen template inputs exist and the configured color interpreter imports its modules; generation still needs functional validation.",
            "Install the source-owned Matugen templates and official Arch python-pillow/python-pip packages, then run `nyvorel color-env --plan` and `nyvorel color-env --install --yes` to create the isolated color environment." if problems else None,
        )

    def run(self) -> None:
        self.check_platform()
        self.load_manifest()
        self.check_installation_files()
        self.load_dependency_contract()
        self.check_dependencies()
        self.check_appearance_runtime()
        self.check_manifest_integrity()
        self.check_materialization()
        self.check_config()
        self.check_session()

    def payload(self) -> dict[str, Any]:
        counts = {
            status: sum(1 for check in self.checks if check.status == status)
            for status in ("PASS", "WARN", "FAIL", "SKIP")
        }

        if counts["FAIL"]:
            result = "FAIL"
        elif counts["WARN"]:
            result = "WARN"
        else:
            result = "PASS"

        return {
            "schema": SCHEMA,
            "product": "Nyvorel",
            "doctor_version": DOCTOR_VERSION,
            "target_home": str(self.home),
            "source_kind": self.source_kind,
            "deep": self.deep,
            "session_checks": self.session_checks,
            "strict": self.strict,
            "dependency_checks": self.dependency_checks,
            "dependencies": self.dependency_report,
            "summary": counts,
            "result": result,
            "checks": [asdict(check) for check in self.checks],
        }

    def exit_code(self) -> int:
        payload = self.payload()
        if payload["summary"]["FAIL"]:
            return 1
        if self.strict and payload["summary"]["WARN"]:
            return 1
        return 0


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        prog="nyvorel doctor",
        description="Read-only Nyvorel installation and desktop diagnostics.",
    )
    parser.add_argument(
        "--deep",
        action="store_true",
        help="Hash-check every managed manifest entry instead of only critical files.",
    )
    parser.add_argument(
        "--json",
        action="store_true",
        help="Emit machine-readable JSON only.",
    )
    parser.add_argument(
        "--strict",
        action="store_true",
        help="Return non-zero when warnings are present.",
    )
    parser.add_argument(
        "--home",
        metavar="PATH",
        help="Inspect another home directory (session checks are skipped).",
    )
    parser.add_argument(
        "--dependencies",
        action="store_true",
        help="Force read-only required/optional dependency probing even when session checks are skipped.",
    )
    parser.add_argument(
        "--no-session",
        action="store_true",
        help="Skip live Hyprland/systemd/Quickshell session checks.",
    )
    return parser.parse_args()


def main() -> int:
    args = parse_args()

    real_home = Path.home().resolve(strict=False)
    target_home = (
        Path(args.home).expanduser().resolve(strict=False)
        if args.home
        else real_home
    )

    session_checks = not args.no_session and target_home == real_home
    dependency_checks = session_checks or args.dependencies

    doctor = Doctor(
        target_home,
        deep=args.deep,
        session_checks=session_checks,
        dependency_checks=dependency_checks,
        strict=args.strict,
    )
    doctor.run()
    payload = doctor.payload()

    if args.json:
        print(json.dumps(payload, indent=2))
    else:
        mode = "deep" if args.deep else "standard"
        print("============================================================")
        print("NYVOREL DOCTOR")
        print("============================================================")
        print(f"Target home    : {target_home}")
        print(f"Mode           : {mode}")
        print(f"Session checks : {'yes' if session_checks else 'no'}")
        print(f"Dependency checks: {'yes' if dependency_checks else 'no'}")
        print()

        for check in doctor.checks:
            print(f"{check.status:<4}  {check.title}")
            print(f"      {check.detail}")
            if check.fix:
                print(f"      Fix: {check.fix}")

        counts = payload["summary"]
        print()
        print(
            "Summary: "
            f"PASS={counts['PASS']} "
            f"WARN={counts['WARN']} "
            f"FAIL={counts['FAIL']} "
            f"SKIP={counts['SKIP']}"
        )
        print(f"RESULT: {payload['result']}")

    return doctor.exit_code()


if __name__ == "__main__":
    raise SystemExit(main())
