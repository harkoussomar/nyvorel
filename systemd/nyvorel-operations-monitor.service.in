[Unit]
Description=Nyvorel Operations Center monitor
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 %h/.config/quickshell/nyvorel/scripts/operations-center/operations.py monitor
Restart=on-failure
RestartSec=2
Nice=10
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
