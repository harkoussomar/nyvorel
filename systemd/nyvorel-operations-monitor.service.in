[Unit]
Description=Nyvorel Operations Center monitor
After=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.config/quickshell/nyvorel/scripts/system/nyvorel-operations monitor
Restart=on-failure
RestartSec=2
Nice=10
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
