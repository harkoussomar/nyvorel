#!/usr/bin/env python3
"""List readable wallpaper entries for paths Qt's folder model cannot open."""

import json
import os
from pathlib import Path
import sys

EXTENSIONS = {".jpg", ".jpeg", ".png", ".webp", ".avif", ".bmp", ".svg"}


def list_images(directory):
    entries = []
    for path in directory.iterdir():
        if path.name.startswith("."):
            continue
        is_directory = path.is_dir()
        if is_directory and os.access(path, os.R_OK | os.X_OK):
            entries.append({"path": str(path), "directory": True})
        elif not is_directory and path.suffix.casefold() in EXTENSIONS and path.is_file() and os.access(path, os.R_OK):
            entries.append({"path": str(path), "directory": False})
    return sorted(entries, key=lambda entry: (not entry["directory"], Path(entry["path"]).name.casefold()))


if __name__ == "__main__":
    try:
        print(json.dumps(list_images(Path(sys.argv[1]))))
    except (IndexError, OSError) as error:
        print(error, file=sys.stderr)
        sys.exit(1)
