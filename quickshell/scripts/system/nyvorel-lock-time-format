#!/usr/bin/env python3
"""Set Hyprlock's time token atomically for the Settings time-format control."""

import argparse
import json
import os
import re
import sys
import tempfile
from pathlib import Path


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--format", choices=("hh:mm", "h:mm ap", "h:mm AP"), required=True)
    args = parser.parse_args()

    config_home = Path(os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config")
    path = config_home / "hypr" / "hyprlock.conf"
    if not path.is_file():
        raise RuntimeError(f"Hyprlock configuration is missing: {path}")

    original = path.read_text(encoding="utf-8")
    pattern = re.compile(r"(?m)^(\s*text\s*=\s*)\$(TIME12|TIME)(\s*(?:#.*)?)$")
    matches = list(pattern.finditer(original))
    if len(matches) != 1:
        raise RuntimeError("Expected one Hyprlock time label; no change was saved")

    token = "TIME" if args.format == "hh:mm" else "TIME12"
    updated = pattern.sub(lambda match: f"{match.group(1)}${token}{match.group(3)}", original, count=1)
    if updated != original:
        descriptor, temp_name = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
        temp_path = Path(temp_name)
        try:
            with os.fdopen(descriptor, "w", encoding="utf-8") as output:
                output.write(updated)
                output.flush()
                os.fsync(output.fileno())
            os.chmod(temp_path, path.stat().st_mode & 0o777)
            os.replace(temp_path, path)
        finally:
            temp_path.unlink(missing_ok=True)

    print(json.dumps({"ok": True, "token": token}))
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (OSError, RuntimeError) as error:
        print(json.dumps({"ok": False, "error": str(error)}))
        raise SystemExit(1) from None
