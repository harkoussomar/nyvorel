#!/usr/bin/env python3
"""Discover XKB layouts and change Hyprland's live keyboard selection."""

import argparse
import json
import os
import subprocess
import time
import xml.etree.ElementTree as ET
from pathlib import Path


RULES = Path(os.environ.get("NYVOREL_XKB_RULES_FILE", "/usr/share/X11/xkb/rules/evdev.xml"))
EMPTY = {"", "[[EMPTY]]", "[[Empty]]"}


def catalog():
    root = ET.parse(RULES).getroot()
    layouts = root.find("layoutList")
    if layouts is None:
        raise ValueError("XKB layout catalogue is missing")
    entries = []
    for layout in layouts.findall("layout"):
        code = layout.findtext("configItem/name", "").strip()
        name = layout.findtext("configItem/description", code).strip()
        if not code:
            continue
        entries.append({"value": code, "displayName": name, "layout": code, "variant": "", "family": name})
        variants = layout.find("variantList")
        if variants is None:
            continue
        for variant in variants.findall("variant"):
            variant_code = variant.findtext("configItem/name", "").strip()
            variant_name = variant.findtext("configItem/description", variant_code).strip()
            if variant_code:
                entries.append({
                    "value": f"{code}:{variant_code}", "displayName": variant_name,
                    "layout": code, "variant": variant_code, "family": name,
                })
    return entries


def request(*args):
    return subprocess.run(["hyprctl", *args], capture_output=True, text=True, timeout=5, check=False)


def hyprctl(*args):
    result = request(*args)
    if result.returncode:
        message = (result.stderr or result.stdout).strip()
        raise RuntimeError(message or f"hyprctl failed ({result.returncode})")
    return result.stdout


def option(name):
    value = json.loads(hyprctl("getoption", f"input:{name}", "-j"))
    raw = str(value.get("str", ""))
    return "" if raw in EMPTY else raw


def configured_options():
    return option("kb_layout"), option("kb_variant")


def main_keyboard():
    devices = json.loads(hyprctl("devices", "-j"))
    keyboards = devices.get("keyboards", [])
    return next((device for device in keyboards if device.get("main")),
                keyboards[0] if keyboards else {})


def keyboard_status(configured, device):
    layouts = (device.get("layout") or configured[0]).split(",")
    variants = (device.get("variant", configured[1]) or "").split(",")
    active_keymap = device.get("active_keymap", "")
    index = device.get("active_layout_index")
    if not isinstance(index, int) or not 0 <= index < len(layouts):
        index = 0
        if len(layouts) > 1 and active_keymap:
            by_name = {item["value"]: item["displayName"] for item in catalog()}
            for candidate, layout in enumerate(layouts):
                variant = variants[candidate].strip() if candidate < len(variants) else ""
                code = f"{layout.strip()}:{variant}" if variant else layout.strip()
                if by_name.get(code) == active_keymap:
                    index = candidate
                    break
    return {
        "ok": True,
        "layout": layouts[index].strip(),
        "variant": variants[index].strip() if index < len(variants) else "",
        "activeKeymap": active_keymap,
    }


def status():
    configured = configured_options()
    try:
        device = main_keyboard()
    except (ValueError, RuntimeError, subprocess.TimeoutExpired):
        device = {}
    return keyboard_status(configured, device)


def write_options(layout, variant):
    lua = "hl.config({input={kb_layout=%s,kb_variant=%s}})" % (
        json.dumps(layout, ensure_ascii=False), json.dumps(variant, ensure_ascii=False)
    )
    result = request("eval", lua)
    reply = (result.stdout or result.stderr).strip()
    if result.returncode == 0 and reply == "ok":
        return
    unsupported = reply.lower() in {"unknown request", "invalid command", "unknown command"}
    if not unsupported and not (result.returncode == 2 and not reply):
        raise RuntimeError(reply or "Hyprland could not update keyboard settings")

    # Older Hyprland configurations use the legacy keyword command.
    for name, value in (("kb_layout", layout), ("kb_variant", variant)):
        reply = hyprctl("keyword", f"input:{name}", value).strip()
        if reply != "ok":
            raise RuntimeError(reply or f"Hyprland could not set {name}")


def set_layout(code):
    entry = next((item for item in catalog() if item["value"] == code), None)
    if entry is None:
        raise ValueError(f"This layout is not installed: {code}")
    before = configured_options()
    requested = entry["layout"], entry["variant"]
    try:
        write_options(*requested)
        configured = configured_options()
        if configured != requested:
            raise RuntimeError("Hyprland did not accept the selected layout")
        for attempt in range(5):
            after = keyboard_status(configured, main_keyboard())
            if (after["layout"], after["variant"]) == requested:
                return {**after, "selected": code}
            if attempt < 4:
                time.sleep(0.06)
        raise RuntimeError("The active keyboard did not switch to the selected layout")
    except (ValueError, RuntimeError, subprocess.TimeoutExpired):
        try:
            write_options(*before)
        except (RuntimeError, subprocess.TimeoutExpired):
            pass
        raise


def restore():
    # Re-evaluate the user's actual Hyprland config, including Lua expressions.
    # Parsing that file ourselves would silently choose the wrong layout.
    hyprctl("reload")
    for _ in range(12):
        try:
            return status()
        except (RuntimeError, ValueError, subprocess.TimeoutExpired):
            time.sleep(0.1)
    raise RuntimeError("Hyprland reloaded, but its keyboard state could not be read")


def main():
    parser = argparse.ArgumentParser()
    subcommands = parser.add_subparsers(dest="command", required=True)
    subcommands.add_parser("catalog")
    subcommands.add_parser("status")
    choose = subcommands.add_parser("set")
    choose.add_argument("code")
    subcommands.add_parser("restore")
    args = parser.parse_args()
    if args.command == "catalog":
        payload = {"ok": True, "choices": catalog()}
    elif args.command == "status":
        payload = status()
    elif args.command == "set":
        payload = set_layout(args.code)
    else:
        payload = restore()
    print(json.dumps(payload, ensure_ascii=False))
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (OSError, ValueError, RuntimeError, ET.ParseError, subprocess.TimeoutExpired) as error:
        print(json.dumps({"ok": False, "error": str(error)}))
        raise SystemExit(1) from None
