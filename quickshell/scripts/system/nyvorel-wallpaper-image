#!/usr/bin/env python3
"""Create a cached, display-sized copy when Qt cannot decode the original."""

import fcntl
from hashlib import sha256
import os
from pathlib import Path
import stat
import subprocess
import sys
import tempfile
from urllib.parse import unquote, urlsplit


def local_path(value):
    if value.startswith("file://"):
        url = urlsplit(value)
        if url.netloc not in ("", "localhost"):
            raise ValueError("Expected a local wallpaper file")
        value = unquote(url.path)
    path = Path(value)
    if not path.is_absolute():
        raise ValueError("Expected an absolute wallpaper path")
    return path.resolve(strict=True)


def resize(path, edge, output):
    try:
        from PIL import Image, ImageOps
    except ImportError:
        pass
    else:
        try:
            with Image.open(path) as source:
                source.thumbnail((edge, edge), Image.Resampling.BILINEAR, reducing_gap=2.0)
                oriented = ImageOps.exif_transpose(source)
                oriented.save(output, "PNG", compress_level=2)
            return
        except (Image.DecompressionBombError, OSError, ValueError):
            pass

    subprocess.run(
        ["magick", "-limit", "thread", "2", "-limit", "memory", "256MiB",
         "-limit", "map", "768MiB", "-limit", "disk", "1GiB",
         f"{path}[0]", "-auto-orient", "-thumbnail", f"{edge}x{edge}>",
         "-strip", "-define", "png:compression-level=2", str(output)],
        stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, check=True, timeout=20,
        env=dict(os.environ, MAGICK_TEMPORARY_PATH=str(output.parent)),
    )


def image_copy(path, edge):
    source = path.stat()
    if not stat.S_ISREG(source.st_mode):
        raise ValueError("Expected a regular wallpaper file")

    cache_home = Path(os.environ.get("XDG_CACHE_HOME") or Path.home() / ".cache")
    directory = cache_home / "nyvorel" / "wallpaper-images"
    directory.mkdir(mode=0o700, parents=True, exist_ok=True)
    signature = f"{path}\0{source.st_size}\0{source.st_mtime_ns}\0{edge}"
    key = sha256(os.fsencode(signature)).hexdigest()
    cached = directory / f"{key}.png"
    if cached.is_file() and cached.stat().st_size:
        return cached

    with (directory / f"{key}.lock").open("a") as lock:
        fcntl.flock(lock.fileno(), fcntl.LOCK_EX)
        if cached.is_file() and cached.stat().st_size:
            return cached

        fd, temporary_name = tempfile.mkstemp(suffix=".png", dir=directory)
        os.close(fd)
        temporary = Path(temporary_name)
        try:
            resize(path, edge, temporary)
            if not temporary.stat().st_size:
                raise ValueError("No image was produced")
            os.replace(temporary, cached)
        finally:
            temporary.unlink(missing_ok=True)

    return cached


def main():
    try:
        if len(sys.argv) != 3:
            raise ValueError("Usage: nyvorel-wallpaper-image PIXELS PATH")
        edge = int(sys.argv[1])
        if not 128 <= edge <= 4096:
            raise ValueError("The image size must be between 128 and 4096 pixels")
        print(image_copy(local_path(sys.argv[2]), edge))
    except (ValueError, OSError, subprocess.SubprocessError) as error:
        print(error, file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
